---
const year = new Date().getFullYear();
---

<!--
  One line. The colophon above it is the closing statement, so all the footer
  has left to do is the small print: who owns this and where the terms are.
  Product links here would only point back up a page the reader has just
  finished reading.
-->
<footer class="foot">
  <div class="wrap foot-line">
    <span>© Resurface {year}</span>
    <nav class="foot-links" aria-label="Legal">
      <!-- Absolute, not relative. Google's OAuth brand verification compares
           this href against the privacy URL on the consent screen as a string,
           and "/privacy" does not match "https://tryresurface.com/privacy"
           however identically the two resolve in a browser. -->
      <a href="https://tryresurface.com/privacy">Privacy policy</a>
      <a href="https://tryresurface.com/terms">Terms of service</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    background: var(--panel);
    border-top: 1px solid var(--line);
    padding: 20px 0 calc(20px + env(safe-area-inset-bottom, 0px));
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 24px;
  }
  .foot-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 13.5px;
    color: var(--ink-faint);
  }
  .foot-links {
    display: flex;
    gap: 22px;
  }
  .foot-links a {
    color: var(--ink-faint);
    transition: color 0.16s ease;
  }
  .foot-links a:hover {
    color: var(--blue);
  }

  @media (max-width: 560px) {
    .foot-line {
      justify-content: flex-start;
    }
  }
</style>
