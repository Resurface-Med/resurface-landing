---
const APP_URL = "https://app.tryresurface.com";
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot-top">
    <!--
      A dictionary entry instead of a logo and a strapline. The lockup is
      already at the top of every page, so repeating it here says nothing; the
      definition says the one thing the product is for.
    -->
    <div class="foot-mark">
      <!-- Guide words: the first and last entries on a dictionary spread,
           printed in the top corners so you can find a page by thumbing. The
           pair here brackets the headword alphabetically, and the left one is
           the technique this whole product exists to argue against. -->
      <p class="foot-guide" aria-hidden="true"><span>restudy</span><span>resurgence</span></p>

      <p class="foot-word">resurface</p>
      <p class="foot-pron"><span class="ipa">/ˌriːˈsəːfɪs/</span> <span class="pos">verb</span></p>

      <p class="foot-senses"><b>1</b> to rise back up to the surface. <b>2</b> to bring a thing back into view <em class="key">just before it is lost</em>: <i>material resurfaces the day before you would have forgotten it.</i></p>

      <p class="foot-etym"><span class="lbl">origin</span> <i>from</i> <b>re-</b> <i>‘again’</i> + <b>surface</b>, <i>from Latin</i> superficies <i>‘upper face’.</i></p>
    </div>

    <div class="foot-cols">
      <nav class="foot-col" aria-label="Product">
        <h2>Product</h2>
        <a href="/#subjects">Try a question</a>
        <a href="/#ai">AI questions</a>
        <a href="/#how">How it works</a>
      </nav>

      <nav class="foot-col" aria-label="Legal">
        <h2>Legal</h2>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:hello@tryresurface.com">Contact</a>
      </nav>

      <div class="foot-col">
        <h2>Start</h2>
        <a class="foot-cta" href={APP_URL}>Start studying →</a>
      </div>
    </div>
  </div>

  <div class="wrap foot-base">
    <span>© Resurface {year}</span>
    <span class="foot-base-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    background: var(--panel);
    padding: clamp(40px, 6vh, 64px) 0 26px;
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 24px;
  }

  .foot-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 64px);
  }
  .foot-mark {
    max-width: 44ch;
  }

  .foot-cols {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 104px;
  }
  .foot-col h2 {
    margin: 0 0 3px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .foot-col a {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.16s ease;
  }
  .foot-col a:hover {
    color: var(--blue);
  }
  .foot-cta {
    color: var(--blue) !important;
    font-weight: 600 !important;
  }

  /* ---------------------------------------------------------- COLOPHON */
  /* An entry, set the way an entry is set: syllable points in the headword,
     pronunciation and part of speech on their own line, senses numbered with
     a hanging indent so the numerals sit outside the text block. */
  .foot-word {
    margin: 0;
    font-size: clamp(38px, 5.4vw, 60px);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--blue);
  }
  .foot-pron {
    margin: 14px 0 0;
    font-size: 14.5px;
    color: var(--ink-faint);
  }
  .foot-pron .mid {
    margin: 0 8px;
    opacity: 0.6;
  }
  .foot-pron em {
    font-style: italic;
    color: var(--ink-soft);
  }

  .foot-senses {
    list-style: none;
    counter-reset: sense;
    margin: 16px 0 0;
    padding: 0;
  }
  .foot-senses li {
    counter-increment: sense;
    position: relative;
    padding-left: 24px;
    margin-top: 7px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .foot-senses li::before {
    content: counter(sense);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-faint);
  }
  /* The sense the product is named for. */
  .foot-senses b {
    font-weight: 600;
    color: var(--ink);
  }
  /* The clause the product exists for, so it gets the emphasis. */
  .foot-def span {
    color: var(--blue);
  }

  .foot-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(32px, 5vh, 52px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--ink-faint);
  }
  .foot-base-links {
    display: flex;
    gap: 18px;
  }
  .foot-base-links a {
    color: var(--ink-faint);
  }
  .foot-base-links a:hover {
    color: var(--blue);
  }

  @media (max-width: 780px) {
    .foot-top {
      flex-direction: column;
      gap: 32px;
    }
    .foot-cols {
      gap: 28px 44px;
    }
    .foot-word {
      letter-spacing: -1.4px;
    }
  }
</style>
