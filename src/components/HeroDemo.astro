---
/**
 * The animated product demo in the hero.
 *
 * Markup only — every scene's elements exist in the DOM from the start and the
 * timeline reveals them. Nothing is created at runtime, so the animation can be
 * scrubbed, replayed and reasoned about from one place (scripts/heroTimeline.js)
 * rather than being spread across the components it touches.
 */
---

<div class="hero-demo" data-hero-demo>
  <div class="hero-demo__card" data-demo-card></div>
</div>

<style>
  .hero-demo {
    position: relative;
    width: 100%;
  }
  .hero-demo__card {
    position: relative;
    background: var(--white);
    border-radius: 24px;
    box-shadow:
      0 2px 6px rgba(15, 27, 61, 0.06),
      0 24px 64px rgba(20, 44, 130, 0.18);
    aspect-ratio: 4 / 3;
  }
</style>

<script>
  import { buildHeroTimeline } from "../scripts/heroTimeline.js";
  buildHeroTimeline();
</script>
