---
/**
 * Hero stage — editorial, not a product tour.
 *
 * A lecture sheet sinks. The fact resurfaces as giant type. One metaphor,
 * readable at a glance. No app chrome, no step list, no micro-UI to decode.
 */
---

<div class="ed" data-hero-demo aria-hidden="true">
  <div class="ed-stage">
    <!-- Ghost word in the field — atmosphere, not UI -->
    <p class="ed-ghost" data-ghost>sink</p>

    <!-- The lecture: a real page that will go under -->
    <article class="ed-sheet" data-sheet>
      <p class="ed-sheet__file">Lecture 12 · Adrenergic receptors</p>
      <h3 class="ed-sheet__title">What you just sat through</h3>
      <ul class="ed-sheet__lines">
        <li>α1 — vessels, Gq</li>
        <li data-line>β1 — heart, Gs, ↑ cAMP</li>
        <li>β2 — lungs, Gs</li>
      </ul>
      <p class="ed-sheet__note" data-note>…will be gone by Friday</p>
    </article>

    <!-- What comes back — oversized, unmissable -->
    <div class="ed-back" data-back>
      <p class="ed-back__tag" data-tag>Resurfaced</p>
      <p class="ed-back__q" data-q>β1 receptors are coupled to?</p>
      <p class="ed-back__a" data-a>Gs → ↑ cAMP</p>
    </div>
  </div>
</div>

<style>
  .ed {
    --ed-w: min(100%, 440px);
    width: var(--ed-w);
    margin-inline: auto;
  }

  .ed-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.12;
    overflow: hidden;
    border-radius: 28px;
    /* A deeper pocket of the field — so sink/rise reads as depth */
    background:
      radial-gradient(
        120% 80% at 50% 110%,
        rgba(15, 27, 61, 0.35) 0%,
        transparent 55%
      ),
      rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 -40px 80px rgba(15, 27, 61, 0.18);
  }

  .ed-ghost {
    position: absolute;
    left: 50%;
    top: 42%;
    margin: 0;
    transform: translate(-50%, -50%);
    font-size: clamp(72px, 22vw, 120px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.07);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ SHEET */
  .ed-sheet {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 10%;
    padding: 22px 22px 24px;
    background: #fff;
    color: var(--ink);
    border-radius: 18px;
    box-shadow:
      0 2px 6px rgba(15, 27, 61, 0.06),
      0 28px 60px rgba(20, 44, 130, 0.22);
    transform-origin: 50% 80%;
  }
  .ed-sheet__file {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .ed-sheet__title {
    margin: 0 0 16px;
    font-size: clamp(20px, 4.2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.7px;
    line-height: 1.15;
    color: var(--ink);
  }
  .ed-sheet__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .ed-sheet__lines li {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.15px;
    color: var(--ink-soft);
    padding: 6px 10px;
    border-radius: 8px;
  }
  .ed-sheet__lines li[data-line] {
    color: var(--blue);
    font-weight: 700;
    background: rgba(53, 98, 245, 0.1);
  }
  .ed-sheet__note {
    margin: 16px 0 0;
    font-family: "Caveat", cursive;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(15, 27, 61, 0.45);
    transform: rotate(-2deg);
    transform-origin: left center;
  }

  /* ------------------------------------------------------------- BACK */
  .ed-back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 24px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .ed-back__tag {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--peri);
  }
  .ed-back__q {
    margin: 0;
    max-width: 14em;
    font-size: clamp(26px, 5.5vw, 34px);
    font-weight: 600;
    letter-spacing: -1.1px;
    line-height: 1.15;
    color: #fff;
  }
  .ed-back__a {
    margin: 18px 0 0;
    font-size: clamp(36px, 8vw, 52px);
    font-weight: 800;
    letter-spacing: -1.8px;
    line-height: 1;
    color: #fff;
  }

  @media (max-width: 1040px) {
    .ed {
      --ed-w: min(100%, 380px);
    }
  }

  @media (max-width: 560px) {
    .ed {
      --ed-w: min(100%, 300px);
    }
    .ed-stage {
      aspect-ratio: 1 / 1.15;
      border-radius: 22px;
    }
    .ed-ghost {
      font-size: 64px;
    }
    .ed-sheet {
      left: 7%;
      right: 7%;
      top: 9%;
      padding: 16px 16px 18px;
      border-radius: 14px;
    }
    .ed-sheet__title {
      font-size: 18px;
      margin-bottom: 12px;
    }
    .ed-sheet__lines li {
      font-size: 12.5px;
      padding: 5px 8px;
    }
    .ed-sheet__note {
      font-size: 22px;
      margin-top: 12px;
    }
    .ed-back {
      padding: 20px 16px;
    }
    .ed-back__q {
      font-size: 22px;
      letter-spacing: -0.7px;
    }
    .ed-back__a {
      font-size: 34px;
      margin-top: 14px;
      letter-spacing: -1.2px;
    }
  }

  @media (max-width: 380px) {
    .ed {
      --ed-w: min(100%, 272px);
    }
  }
</style>

<script>
  import { buildHeroTimeline } from "../scripts/heroTimeline.js";
  buildHeroTimeline();
</script>
