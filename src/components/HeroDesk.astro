---
/**
 * Hero atmosphere: a quiet study desk under a lamp.
 * No product UI — just the place you revise.
 */
---

<div class="hdesk" aria-hidden="true">
  <div class="hdesk-glow"></div>

  <div class="hdesk-scene">
    <div class="hdesk-lamp">
      <span class="hdesk-lamp-arm"></span>
      <span class="hdesk-lamp-head"></span>
      <span class="hdesk-lamp-beam"></span>
    </div>

    <div class="hdesk-surface">
      <div class="hdesk-notebook">
        <span class="hdesk-spine"></span>
        <span class="hdesk-page"></span>
      </div>
      <div class="hdesk-pen"></div>
      <div class="hdesk-mug"></div>
    </div>
  </div>
</div>

<style>
  .hdesk {
    position: relative;
    width: min(100%, 420px);
    height: 340px;
    display: grid;
    place-items: center;
  }

  .hdesk-glow {
    position: absolute;
    width: 78%;
    height: 58%;
    left: 12%;
    top: 28%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 214, 140, 0.38) 0%,
      rgba(255, 190, 90, 0.14) 42%,
      transparent 72%
    );
    filter: blur(8px);
    pointer-events: none;
  }

  .hdesk-scene {
    position: relative;
    width: 100%;
    height: 100%;
    transform: rotate(-4deg);
  }

  /* ── Lamp ─────────────────────────────────────────────── */
  .hdesk-lamp {
    position: absolute;
    right: 18%;
    top: 6%;
    width: 120px;
    height: 160px;
    z-index: 3;
  }

  .hdesk-lamp-arm {
    position: absolute;
    left: 52%;
    top: 18px;
    width: 6px;
    height: 92px;
    margin-left: -3px;
    border-radius: 3px;
    background: linear-gradient(180deg, #c9d0e0, #8b93a8);
    box-shadow: 1px 2px 4px rgba(8, 14, 36, 0.25);
    transform: rotate(18deg);
    transform-origin: top center;
  }

  .hdesk-lamp-arm::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -10px;
    width: 36px;
    height: 8px;
    margin-left: -18px;
    border-radius: 4px;
    background: linear-gradient(180deg, #aeb6c8, #7a849c);
  }

  .hdesk-lamp-arm::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -8px;
    width: 22px;
    height: 14px;
    margin-left: -11px;
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(180deg, #d5dbe8, #9aa3b8);
  }

  .hdesk-lamp-head {
    position: absolute;
    left: 8%;
    top: 78px;
    width: 54px;
    height: 28px;
    border-radius: 18px 18px 8px 8px;
    background: linear-gradient(160deg, #e8ecf4 0%, #9aa3b8 55%, #6d768c 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      2px 6px 12px rgba(8, 14, 36, 0.28);
    transform: rotate(-28deg);
  }

  .hdesk-lamp-head::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 3px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 220, 150, 0.85);
    box-shadow: 0 0 14px rgba(255, 200, 100, 0.7);
  }

  .hdesk-lamp-beam {
    position: absolute;
    left: -10px;
    top: 108px;
    width: 0;
    height: 0;
    border-left: 48px solid transparent;
    border-right: 70px solid transparent;
    border-top: 118px solid rgba(255, 214, 140, 0.16);
    filter: blur(1px);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  /* ── Desk ─────────────────────────────────────────────── */
  .hdesk-surface {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 18px;
    height: 118px;
    border-radius: 10px 14px 18px 12px;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.08), transparent 40%),
      linear-gradient(180deg, #5a4636 0%, #3d2e24 55%, #2a1f18 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 230, 190, 0.18),
      0 18px 36px rgba(8, 14, 36, 0.35);
    transform: perspective(700px) rotateX(58deg) rotateZ(-2deg);
    transform-origin: center bottom;
  }

  .hdesk-notebook {
    position: absolute;
    left: 16%;
    top: 22%;
    width: 42%;
    height: 48%;
    transform: rotate(-6deg);
  }

  .hdesk-spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10%;
    border-radius: 3px 0 0 3px;
    background: linear-gradient(90deg, #1d4ed8, #3562f5);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .hdesk-page {
    position: absolute;
    left: 8%;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 0 4px 4px 0;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0 7px,
        rgba(77, 142, 245, 0.12) 7px 8px
      ),
      linear-gradient(180deg, #f7f8fc, #e8edf8);
    box-shadow:
      2px 3px 8px rgba(8, 14, 36, 0.2),
      inset 0 0 0 1px rgba(15, 27, 61, 0.06);
  }

  .hdesk-pen {
    position: absolute;
    right: 28%;
    top: 38%;
    width: 34%;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, #c9a227, #8a7018 70%, #2a2118);
    transform: rotate(18deg);
    box-shadow: 1px 2px 4px rgba(8, 14, 36, 0.25);
  }

  .hdesk-mug {
    position: absolute;
    right: 12%;
    top: 28%;
    width: 16%;
    height: 34%;
    border-radius: 4px 4px 6px 6px;
    background: linear-gradient(160deg, #f3f6fe, #c5d0ea 60%, #8a93ae);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      2px 4px 8px rgba(8, 14, 36, 0.22);
  }

  .hdesk-mug::after {
    content: "";
    position: absolute;
    right: -22%;
    top: 22%;
    width: 28%;
    height: 38%;
    border: 3px solid #aeb6c8;
    border-left: none;
    border-radius: 0 10px 10px 0;
  }
</style>
