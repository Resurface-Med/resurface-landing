---
/**
 * Hero product shot: an angled iPad framing the real app Dashboard
 * (served at /preview/dashboard on the app origin).
 */
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const previewUrl = `${appUrl.replace(/\/$/, "")}/preview/dashboard`;
---

<div class="hipad" aria-hidden="true">
  <div class="hipad-scene">
    <div class="hipad-body">
      <span class="hipad-cam"></span>
      <div class="hipad-screen">
        <div class="hipad-viewport">
          <iframe
            class="hipad-frame"
            src={previewUrl}
            title="Resurface dashboard"
            loading="lazy"
            tabindex="-1"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
  <div class="hipad-shadow"></div>
</div>

<style>
  .hipad {
    position: relative;
    width: min(100%, 420px);
    padding: 12px 36px 28px 8px;
    perspective: 1400px;
  }

  .hipad-scene {
    position: relative;
    z-index: 1;
    transform: rotateX(8deg) rotateY(-22deg) rotateZ(2deg);
    transform-style: preserve-3d;
  }

  .hipad-body {
    position: relative;
    background: linear-gradient(145deg, #343b52 0%, #1a1f2e 48%, #0e121c 100%);
    border-radius: 30px;
    padding: 15px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset -1px 0 0 rgba(255, 255, 255, 0.06),
      inset 1px 0 0 rgba(0, 0, 0, 0.25),
      12px 22px 36px rgba(8, 14, 36, 0.28);
  }

  .hipad-cam {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: #070a12;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .hipad-screen {
    background: #3562f5;
    border-radius: 14px;
    overflow: hidden;
    height: 290px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
  }

  .hipad-viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .hipad-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1180px;
    height: 920px;
    border: 0;
    transform: scale(0.33);
    transform-origin: top left;
    pointer-events: none;
    background: #3562f5;
  }

  .hipad-shadow {
    position: absolute;
    left: 12%;
    right: 0;
    bottom: 2px;
    height: 26px;
    border-radius: 50%;
    background: rgba(8, 14, 36, 0.4);
    filter: blur(14px);
    z-index: 0;
    transform: skewX(-18deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hipad-scene {
      transform: rotateX(6deg) rotateY(-16deg);
    }
  }
</style>
