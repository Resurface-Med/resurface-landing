---
/**
 * Hero product shot: an angled laptop framing the real practice session
 * (served at /preview/practice on the app origin).
 */
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const previewUrl = `${appUrl.replace(/\/$/, "")}/preview/practice`;
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-scene">
    <div class="hlaptop-lid">
      <div class="hlaptop-bezel">
        <span class="hlaptop-cam"></span>
        <div class="hlaptop-screen">
          <div class="hlaptop-viewport">
            <iframe
              class="hlaptop-frame"
              src={previewUrl}
              title="Resurface practice question"
              loading="lazy"
              tabindex="-1"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <div class="hlaptop-hinge"></div>

    <div class="hlaptop-deck">
      <div class="hlaptop-keys" aria-hidden="true">
        {Array.from({ length: 14 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-keys is-mid" aria-hidden="true">
        {Array.from({ length: 12 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-keys is-low" aria-hidden="true">
        {Array.from({ length: 11 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-space"></div>
      <div class="hlaptop-pad"></div>
    </div>
  </div>

  <div class="hlaptop-shadow"></div>
</div>

<style>
  .hlaptop {
    position: relative;
    width: min(100%, 480px);
    padding: 8px 40px 44px 4px;
    perspective: 1600px;
  }

  .hlaptop-scene {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateX(10deg) rotateY(-26deg) rotateZ(1.5deg);
  }

  .hlaptop-lid {
    position: relative;
    z-index: 2;
    background: linear-gradient(155deg, #3a4258 0%, #1c2232 50%, #10141f 100%);
    border-radius: 14px 14px 4px 4px;
    padding: 10px 10px 8px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      10px 20px 32px rgba(8, 14, 36, 0.3);
  }

  .hlaptop-bezel {
    position: relative;
    background: #080b14;
    border-radius: 8px;
    padding: 11px 7px 7px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .hlaptop-cam {
    position: absolute;
    top: 3px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4560, #121722 70%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hlaptop-screen {
    background: #3562f5;
    border-radius: 3px;
    overflow: hidden;
    height: 248px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .hlaptop-viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  /* Crop into the question card — zoomed, not a tiny full page. */
  .hlaptop-frame {
    position: absolute;
    top: -8px;
    left: -40px;
    width: 720px;
    height: 700px;
    border: 0;
    transform: scale(0.64);
    transform-origin: top left;
    pointer-events: none;
    background: #3562f5;
  }

  .hlaptop-hinge {
    height: 7px;
    margin: 0 8px;
    background: linear-gradient(180deg, #4a536c, #1a2030);
    border-radius: 0 0 3px 3px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .hlaptop-deck {
    position: relative;
    z-index: 1;
    height: 108px;
    margin: 0 -3%;
    padding: 10px 9% 12px;
    background: linear-gradient(180deg, #3a4258 0%, #222836 40%, #141924 100%);
    border-radius: 0 0 18px 18px;
    transform-origin: top center;
    transform: rotateX(52deg);
    transform-style: preserve-3d;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 16px 26px rgba(8, 14, 36, 0.24);
  }

  .hlaptop-keys {
    display: flex;
    justify-content: center;
    gap: 3px;
    margin-bottom: 3px;
  }
  .hlaptop-keys.is-mid {
    padding: 0 3%;
  }
  .hlaptop-keys.is-low {
    padding: 0 7%;
  }

  .hlaptop-key {
    flex: 1;
    height: 8px;
    max-width: 16px;
    border-radius: 2px;
    background: linear-gradient(180deg, #4a536c, #252b3c);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 1px 0 rgba(0, 0, 0, 0.4);
  }

  .hlaptop-space {
    width: 42%;
    height: 7px;
    margin: 4px auto 8px;
    border-radius: 2px;
    background: linear-gradient(180deg, #3a4258, #1c2232);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .hlaptop-pad {
    width: 30%;
    height: 16px;
    margin: 0 auto;
    border-radius: 5px;
    background: #0c1018;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .hlaptop-shadow {
    position: absolute;
    left: 8%;
    right: -2%;
    bottom: 4px;
    height: 28px;
    border-radius: 50%;
    background: rgba(8, 14, 36, 0.42);
    filter: blur(16px);
    z-index: 0;
    transform: skewX(-18deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hlaptop-scene {
      transform: rotateX(8deg) rotateY(-20deg);
    }
  }
</style>
