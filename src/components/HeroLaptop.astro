---
/**
 * Hero product shot: an angled laptop with one neutral practice question.
 * Decorative — not interactive. Copy comes from the real sample bank.
 */
interface Props {
  subject: string;
  topic: string;
  stem: string;
  options: string[];
}

const { subject, topic, stem, options } = Astro.props;
const letters = ["A", "B", "C", "D", "E"];
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-scene">
    <div class="hlaptop-lid">
      <div class="hlaptop-bezel">
        <span class="hlaptop-cam"></span>
        <div class="hlaptop-screen">
          <header class="hlaptop-bar">
            <span class="hlaptop-bar-title">Practice</span>
            <span class="hlaptop-bar-meta">{subject} · {topic}</span>
          </header>
          <div class="hlaptop-body">
            <p class="hlaptop-stem">{stem}</p>
            <ul class="hlaptop-opts">
              {
                options.map((opt, i) => (
                  <li class="hlaptop-opt">
                    <span class="hlaptop-letter">{letters[i]}</span>
                    <span class="hlaptop-opt-text">{opt}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="hlaptop-hinge"></div>

    <div class="hlaptop-deck">
      <div class="hlaptop-keys"></div>
      <div class="hlaptop-pad"></div>
    </div>
  </div>

  <div class="hlaptop-shadow"></div>
</div>

<style>
  .hlaptop {
    position: relative;
    width: min(100%, 560px);
    padding: 8px 28px 36px 8px;
    perspective: 1400px;
  }

  .hlaptop-scene {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateX(14deg) rotateY(-28deg) rotateZ(2deg);
  }

  .hlaptop-lid {
    position: relative;
    z-index: 2;
    background: linear-gradient(160deg, #2c3348 0%, #151a28 55%, #0f1320 100%);
    border-radius: 14px 14px 4px 4px;
    padding: 11px 11px 9px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      8px 18px 28px rgba(8, 14, 36, 0.28);
    transform: translateZ(2px);
  }

  .hlaptop-bezel {
    position: relative;
    background: #0a0d16;
    border-radius: 8px;
    padding: 12px 8px 8px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .hlaptop-cam {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4560, #1a2030 70%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hlaptop-screen {
    background: #f7f8fc;
    border-radius: 4px;
    overflow: hidden;
    min-height: 268px;
    box-shadow: inset 0 0 0 1px rgba(15, 27, 61, 0.04);
  }

  .hlaptop-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 10px;
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
  }

  .hlaptop-bar-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1b3d;
  }

  .hlaptop-bar-meta {
    font-size: 10.5px;
    font-weight: 500;
    color: #6b758c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hlaptop-body {
    padding: 14px 16px 18px;
  }

  .hlaptop-stem {
    margin: 0 0 12px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.35px;
    line-height: 1.3;
    color: #0f1b3d;
  }

  .hlaptop-opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hlaptop-opt {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid rgba(15, 27, 61, 0.08);
    box-shadow: 0 1px 2px rgba(20, 44, 130, 0.04);
  }

  .hlaptop-letter {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-size: 10px;
    font-weight: 600;
    color: #4d8ef5;
    background: rgba(77, 142, 245, 0.12);
  }

  .hlaptop-opt-text {
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.25;
    color: #1a2438;
  }

  .hlaptop-hinge {
    height: 7px;
    margin: -1px 6px 0;
    background: linear-gradient(180deg, #3a4258, #1c2233);
    border-radius: 0 0 3px 3px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Deck foreshortened: reads as the keyboard shelf going away from you. */
  .hlaptop-deck {
    position: relative;
    z-index: 1;
    height: 78px;
    margin: 0 -4%;
    padding: 10px 12% 14px;
    background: linear-gradient(180deg, #2a3144 0%, #1a1f2e 42%, #121722 100%);
    border-radius: 0 0 18px 18px;
    transform-origin: top center;
    transform: rotateX(68deg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 18px 28px rgba(8, 14, 36, 0.22);
  }

  .hlaptop-keys {
    height: 28px;
    border-radius: 4px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.05) 0 7px,
        transparent 7px 9px
      ),
      repeating-linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04) 0 6px,
        transparent 6px 8px
      ),
      #151a28;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    opacity: 0.9;
  }

  .hlaptop-pad {
    width: 34%;
    height: 16px;
    margin: 10px auto 0;
    border-radius: 5px;
    background: #0e121c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hlaptop-shadow {
    position: absolute;
    left: 8%;
    right: 2%;
    bottom: 6px;
    height: 28px;
    border-radius: 50%;
    background: rgba(8, 14, 36, 0.38);
    filter: blur(16px);
    z-index: 0;
    transform: skewX(-18deg);
  }

  @media (max-width: 1200px) {
    .hlaptop {
      width: min(100%, 480px);
    }
    .hlaptop-screen {
      min-height: 240px;
    }
    .hlaptop-deck {
      height: 68px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hlaptop-scene {
      transform: rotateX(10deg) rotateY(-22deg);
    }
  }
</style>
