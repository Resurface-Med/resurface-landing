---
/**
 * Hero product shot: an angled laptop with one neutral practice question.
 * Decorative — not interactive. Copy comes from the real sample bank.
 */
interface Props {
  subject: string;
  topic: string;
  stem: string;
  options: string[];
}

const { subject, topic, stem, options } = Astro.props;
const letters = ["A", "B", "C", "D", "E"];
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-scene">
    <div class="hlaptop-lid">
      <div class="hlaptop-bezel">
        <span class="hlaptop-cam"></span>
        <div class="hlaptop-screen">
          <header class="hlaptop-bar">
            <span class="hlaptop-bar-title">Practice</span>
            <span class="hlaptop-bar-meta">{subject} · {topic}</span>
          </header>
          <div class="hlaptop-body">
            <p class="hlaptop-stem">{stem}</p>
            <ul class="hlaptop-opts">
              {
                options.map((opt, i) => (
                  <li class="hlaptop-opt">
                    <span class="hlaptop-letter">{letters[i]}</span>
                    <span class="hlaptop-opt-text">{opt}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="hlaptop-hinge"></div>

    <div class="hlaptop-deck">
      <div class="hlaptop-keys" aria-hidden="true">
        {
          Array.from({ length: 14 }, () => (
            <span class="hlaptop-key" />
          ))
        }
      </div>
      <div class="hlaptop-keys is-mid" aria-hidden="true">
        {
          Array.from({ length: 12 }, () => (
            <span class="hlaptop-key" />
          ))
        }
      </div>
      <div class="hlaptop-keys is-low" aria-hidden="true">
        {
          Array.from({ length: 11 }, () => (
            <span class="hlaptop-key" />
          ))
        }
      </div>
      <div class="hlaptop-pad"></div>
    </div>
  </div>

  <div class="hlaptop-shadow"></div>
</div>

<style>
  .hlaptop {
    position: relative;
    width: min(100%, 400px);
    padding: 4px 20px 40px 4px;
    perspective: 1200px;
  }

  .hlaptop-scene {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateX(12deg) rotateY(-24deg) rotateZ(1.5deg);
  }

  .hlaptop-lid {
    position: relative;
    z-index: 2;
    background: linear-gradient(160deg, #2c3348 0%, #151a28 55%, #0f1320 100%);
    border-radius: 12px 12px 3px 3px;
    padding: 9px 9px 7px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      6px 14px 22px rgba(8, 14, 36, 0.28);
  }

  .hlaptop-bezel {
    position: relative;
    background: #0a0d16;
    border-radius: 7px;
    padding: 10px 7px 7px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .hlaptop-cam {
    position: absolute;
    top: 3px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4560, #1a2030 70%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hlaptop-screen {
    background: #f7f8fc;
    border-radius: 3px;
    overflow: hidden;
    min-height: 210px;
    box-shadow: inset 0 0 0 1px rgba(15, 27, 61, 0.04);
  }

  .hlaptop-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px 8px;
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
  }

  .hlaptop-bar-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1b3d;
  }

  .hlaptop-bar-meta {
    font-size: 9.5px;
    font-weight: 500;
    color: #6b758c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hlaptop-body {
    padding: 11px 12px 14px;
  }

  .hlaptop-stem {
    margin: 0 0 9px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.3px;
    line-height: 1.3;
    color: #0f1b3d;
  }

  .hlaptop-opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hlaptop-opt {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid rgba(15, 27, 61, 0.08);
    box-shadow: 0 1px 2px rgba(20, 44, 130, 0.04);
  }

  .hlaptop-letter {
    flex: none;
    width: 15px;
    height: 15px;
    border-radius: 5px;
    display: grid;
    place-items: center;
    font-size: 9px;
    font-weight: 600;
    color: #4d8ef5;
    background: rgba(77, 142, 245, 0.12);
  }

  .hlaptop-opt-text {
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.25;
    color: #1a2438;
  }

  .hlaptop-hinge {
    height: 6px;
    margin: 0 5px;
    background: linear-gradient(180deg, #3a4258, #1c2233);
    border-radius: 0 0 3px 3px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Mild foreshortening so the keyboard stays readable. */
  .hlaptop-deck {
    position: relative;
    z-index: 1;
    height: 92px;
    margin: 0 -2%;
    padding: 8px 10% 10px;
    background: linear-gradient(180deg, #32384c 0%, #1c2232 45%, #121722 100%);
    border-radius: 0 0 16px 16px;
    transform-origin: top center;
    transform: rotateX(48deg);
    transform-style: preserve-3d;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 14px 22px rgba(8, 14, 36, 0.2);
  }

  .hlaptop-keys {
    display: flex;
    justify-content: center;
    gap: 2.5px;
    margin-bottom: 3px;
  }
  .hlaptop-keys.is-mid {
    padding: 0 4%;
  }
  .hlaptop-keys.is-low {
    padding: 0 8%;
    margin-bottom: 7px;
  }

  .hlaptop-key {
    flex: 1;
    height: 7px;
    max-width: 14px;
    border-radius: 1.5px;
    background: linear-gradient(180deg, #3a4258, #222836);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .hlaptop-pad {
    width: 32%;
    height: 14px;
    margin: 0 auto;
    border-radius: 4px;
    background: #0e121c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .hlaptop-shadow {
    position: absolute;
    left: 10%;
    right: 4%;
    bottom: 4px;
    height: 22px;
    border-radius: 50%;
    background: rgba(8, 14, 36, 0.36);
    filter: blur(14px);
    z-index: 0;
    transform: skewX(-16deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hlaptop-scene {
      transform: rotateX(10deg) rotateY(-20deg);
    }
  }
</style>
