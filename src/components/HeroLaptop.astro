---
/**
 * Hero product shot: the supplied laptop mockup with the real Dashboard
 * framed in the screen.
 */
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const previewUrl = `${appUrl.replace(/\/$/, "")}/preview/dashboard`;

/** Design width of the dashboard layout inside the iframe. */
const FRAME_W = 1100;
const FRAME_H = 780;
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-screen">
    <div class="hlaptop-fit" style={`--frame-w: ${FRAME_W}; --frame-h: ${FRAME_H}`}>
      <iframe
        class="hlaptop-frame"
        src={previewUrl}
        title="Resurface dashboard"
        loading="lazy"
        tabindex="-1"
        width={FRAME_W}
        height={FRAME_H}
      ></iframe>
    </div>
  </div>
  <img
    class="hlaptop-device"
    src="/laptop-mockup.png"
    alt=""
    width="1024"
    height="1024"
    decoding="async"
  />
</div>

<style>
  .hlaptop {
    position: relative;
    width: min(100%, 580px);
    filter: drop-shadow(0 32px 56px rgba(15, 30, 90, 0.4));
  }

  .hlaptop-device {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  /* Measured from laptop-mockup.png screen rectangle. */
  .hlaptop-screen {
    position: absolute;
    z-index: 2;
    left: 16.89%;
    top: 28.22%;
    width: 66.21%;
    height: 41.31%;
    overflow: hidden;
    background: #3562f5;
    border-radius: 1px;
    container-type: size;
  }

  /* Scale the dashboard so its width exactly matches the screen hole. */
  .hlaptop-fit {
    width: calc(var(--frame-w) * 1px);
    height: calc(var(--frame-h) * 1px);
    transform: scale(calc(100cqw / (var(--frame-w) * 1px)));
    transform-origin: top left;
  }

  .hlaptop-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    background: #3562f5;
  }
</style>
