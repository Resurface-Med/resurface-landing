---
/**
 * Hero product shot: a simple laptop frame with one neutral practice question.
 * Decorative — not interactive. Copy comes from the real sample bank.
 */
interface Props {
  subject: string;
  topic: string;
  stem: string;
  options: string[];
}

const { subject, topic, stem, options } = Astro.props;
const letters = ["A", "B", "C", "D", "E"];
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-lid">
    <div class="hlaptop-bezel">
      <span class="hlaptop-cam"></span>
      <div class="hlaptop-screen">
        <header class="hlaptop-bar">
          <span class="hlaptop-bar-title">Practice</span>
          <span class="hlaptop-bar-meta">{subject} · {topic}</span>
        </header>
        <div class="hlaptop-body">
          <p class="hlaptop-stem">{stem}</p>
          <ul class="hlaptop-opts">
            {
              options.map((opt, i) => (
                <li class="hlaptop-opt">
                  <span class="hlaptop-letter">{letters[i]}</span>
                  <span class="hlaptop-opt-text">{opt}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="hlaptop-base">
    <div class="hlaptop-indent"></div>
  </div>
</div>

<style>
  .hlaptop {
    width: min(100%, 520px);
    filter: drop-shadow(0 28px 48px rgba(15, 30, 90, 0.32));
  }

  .hlaptop-lid {
    background: #1a1f2e;
    border-radius: 12px 12px 0 0;
    padding: 10px 10px 8px;
  }

  .hlaptop-bezel {
    position: relative;
    background: #0f1320;
    border-radius: 8px;
    padding: 10px 8px 8px;
  }

  .hlaptop-cam {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: #2a3144;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .hlaptop-screen {
    background: #f7f8fc;
    border-radius: 4px;
    overflow: hidden;
    min-height: 280px;
  }

  .hlaptop-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 10px;
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
  }

  .hlaptop-bar-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1b3d;
  }

  .hlaptop-bar-meta {
    font-size: 10.5px;
    font-weight: 500;
    color: #6b758c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hlaptop-body {
    padding: 14px 16px 18px;
  }

  .hlaptop-stem {
    margin: 0 0 12px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.35px;
    line-height: 1.3;
    color: #0f1b3d;
  }

  .hlaptop-opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hlaptop-opt {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid rgba(15, 27, 61, 0.08);
    box-shadow: 0 1px 2px rgba(20, 44, 130, 0.04);
  }

  .hlaptop-letter {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-size: 10px;
    font-weight: 600;
    color: #4d8ef5;
    background: rgba(77, 142, 245, 0.12);
  }

  .hlaptop-opt-text {
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.25;
    color: #1a2438;
  }

  .hlaptop-base {
    height: 12px;
    margin: 0 -10px;
    background: linear-gradient(180deg, #2a3144 0%, #1a1f2e 100%);
    border-radius: 0 0 14px 14px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 3px;
  }

  .hlaptop-indent {
    width: 28%;
    height: 4px;
    border-radius: 0 0 6px 6px;
    background: #121621;
  }

  @media (max-width: 1200px) {
    .hlaptop {
      width: min(100%, 440px);
    }
    .hlaptop-screen {
      min-height: 250px;
    }
  }
</style>
