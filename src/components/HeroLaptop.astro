---
/**
 * Hero product shot: an angled laptop framing the real app Dashboard
 * (served at /preview/dashboard on the app origin).
 */
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const previewUrl = `${appUrl.replace(/\/$/, "")}/preview/dashboard`;
---

<div class="hlaptop" aria-hidden="true">
  <div class="hlaptop-scene">
    <div class="hlaptop-lid">
      <div class="hlaptop-bezel">
        <span class="hlaptop-cam"></span>
        <div class="hlaptop-screen">
          <div class="hlaptop-viewport">
            <iframe
              class="hlaptop-frame"
              src={previewUrl}
              title="Resurface dashboard"
              loading="lazy"
              tabindex="-1"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <div class="hlaptop-hinge"></div>

    <div class="hlaptop-deck">
      <div class="hlaptop-keys" aria-hidden="true">
        {Array.from({ length: 14 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-keys is-mid" aria-hidden="true">
        {Array.from({ length: 12 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-keys is-low" aria-hidden="true">
        {Array.from({ length: 11 }, () => <span class="hlaptop-key" />)}
      </div>
      <div class="hlaptop-pad"></div>
    </div>
  </div>

  <div class="hlaptop-shadow"></div>
</div>

<style>
  .hlaptop {
    position: relative;
    width: min(100%, 400px);
    padding: 4px 20px 40px 4px;
    perspective: 1200px;
  }

  .hlaptop-scene {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateX(12deg) rotateY(-24deg) rotateZ(1.5deg);
  }

  .hlaptop-lid {
    position: relative;
    z-index: 2;
    background: linear-gradient(160deg, #2c3348 0%, #151a28 55%, #0f1320 100%);
    border-radius: 12px 12px 3px 3px;
    padding: 9px 9px 7px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      6px 14px 22px rgba(8, 14, 36, 0.28);
  }

  .hlaptop-bezel {
    position: relative;
    background: #0a0d16;
    border-radius: 7px;
    padding: 10px 7px 7px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .hlaptop-cam {
    position: absolute;
    top: 3px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4560, #1a2030 70%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hlaptop-screen {
    background: #3562f5;
    border-radius: 3px;
    overflow: hidden;
    height: 228px;
    box-shadow: inset 0 0 0 1px rgba(15, 27, 61, 0.04);
  }

  .hlaptop-viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  /* Render the real dashboard at desktop width, then scale into the bezel. */
  .hlaptop-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1180px;
    height: 820px;
    border: 0;
    transform: scale(0.32);
    transform-origin: top left;
    pointer-events: none;
    background: #3562f5;
  }

  .hlaptop-hinge {
    height: 6px;
    margin: 0 5px;
    background: linear-gradient(180deg, #3a4258, #1c2233);
    border-radius: 0 0 3px 3px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .hlaptop-deck {
    position: relative;
    z-index: 1;
    height: 92px;
    margin: 0 -2%;
    padding: 8px 10% 10px;
    background: linear-gradient(180deg, #32384c 0%, #1c2232 45%, #121722 100%);
    border-radius: 0 0 16px 16px;
    transform-origin: top center;
    transform: rotateX(48deg);
    transform-style: preserve-3d;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 14px 22px rgba(8, 14, 36, 0.2);
  }

  .hlaptop-keys {
    display: flex;
    justify-content: center;
    gap: 2.5px;
    margin-bottom: 3px;
  }
  .hlaptop-keys.is-mid {
    padding: 0 4%;
  }
  .hlaptop-keys.is-low {
    padding: 0 8%;
    margin-bottom: 7px;
  }

  .hlaptop-key {
    flex: 1;
    height: 7px;
    max-width: 14px;
    border-radius: 1.5px;
    background: linear-gradient(180deg, #3a4258, #222836);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 1px 0 rgba(0, 0, 0, 0.35);
  }

  .hlaptop-pad {
    width: 32%;
    height: 14px;
    margin: 0 auto;
    border-radius: 4px;
    background: #0e121c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .hlaptop-shadow {
    position: absolute;
    left: 10%;
    right: 4%;
    bottom: 4px;
    height: 22px;
    border-radius: 50%;
    background: rgba(8, 14, 36, 0.36);
    filter: blur(14px);
    z-index: 0;
    transform: skewX(-16deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hlaptop-scene {
      transform: rotateX(10deg) rotateY(-20deg);
    }
  }
</style>
