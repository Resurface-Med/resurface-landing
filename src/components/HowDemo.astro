---
/**
 * How it works, animated.
 *
 * The three steps stay as readable text underneath — they are the content, and
 * they work with JavaScript off. The animation runs alongside and lights
 * whichever step it is currently on, so the captions are not a description of
 * the animation, they are the same thing said twice.
 *
 * Everything is drawn in DOM and SVG rather than imported as artwork, because
 * the parts have to move independently: a bullet lights, a page tears into
 * cards, a bar fills. A flat image cannot do any of that.
 */
const STEPS = [
  { n: "1", label: "Drop in your lecture" },
  { n: "2", label: "AI writes questions from it" },
  { n: "3", label: "Answer them, and they come back" },
];

const OPTS = [
  "Gi — decreased cAMP",
  "Gq — IP₃/DAG",
  "Gs — increased cAMP",
  "Nuclear receptor",
];
---

<div class="hw" data-how-demo>
  <!-- A bounded space, so the animation has an area rather than floating in
       the column. Everything below aligns to this frame's edges. -->
  <div class="hw-frame">
    <div class="hw-stage">
    <!-- ACT 1 — the lecture, arriving from outside the app -->
    <div class="hw-doc" data-doc>
      <span class="hw-doc__fold" aria-hidden="true"></span>
      <p class="hw-doc__name">Lecture 12.pdf</p>
      <p class="hw-doc__title">Adrenergic receptors</p>
      <ul class="hw-doc__lines">
        <li>α1 — vasoconstriction</li>
        <li data-source>β1 — heart, ↑ cAMP</li>
        <li>β2 — bronchodilation</li>
      </ul>
      <span class="hw-doc__scan" data-scan aria-hidden="true"></span>
    </div>

    <!-- The app it lands in -->
    <div class="hw-app" data-app>
      <div class="hw-app__bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>Resurface</p>
      </div>

      <div class="hw-app__body">
        <!-- ACT 1 target -->
        <div class="hw-screen" data-screen="drop">
          <div class="hw-zone" data-zone>
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <path
                d="M20 27V9M13 15.5 20 8.5l7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M7 26v4a2 2 0 0 0 2 2h22a2 2 0 0 0 2-2v-4"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"></path>
            </svg>
            <p>Drop a lecture here</p>
          </div>
        </div>

        <!-- ACT 2 — the page becomes questions -->
        <div class="hw-screen" data-screen="make">
          <div class="hw-cards">
            <span data-made></span>
            <span data-made></span>
            <span data-made></span>
            <span data-made></span>
          </div>
          <p class="hw-made"><b data-count>0</b> questions written</p>
        </div>

        <!-- ACT 3 — answering, and the topic filling in -->
        <div class="hw-screen" data-screen="answer">
          <p class="hw-stem">β1 receptors are coupled to:</p>
          <ul class="hw-opts">
            {OPTS.map((o, i) => (
              <li data-opt data-correct={i === 2 ? "true" : undefined}>
                <span class="hw-opt__mark" aria-hidden="true">
                  <svg viewBox="0 0 16 16">
                    <path
                      d="M3.5 8.5 7 12l6-7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      data-tick></path>
                  </svg>
                </span>
                {o}
              </li>
            ))}
          </ul>
          <div class="hw-meter" data-meter>
            <span class="hw-meter__label">Adrenergic receptors</span>
            <span class="hw-meter__track"><i data-fill></i></span>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>

  <!-- The steps: content first, and the animation lights whichever is live. -->
  <ol class="hw-steps">
    {STEPS.map((s, i) => (
      <li data-step={i}>
        <span class="hw-steps__n">{s.n}</span>
        <span class="hw-steps__t">{s.label}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .hw {
    display: grid;
    gap: 14px;
  }

  /* The animation's own space: a glass panel on the field, same language as
     everything else that floats here. The app sits inside its padding, so the
     frame's edges are what the steps below line up with. */
  .hw-frame {
    position: relative;
    padding: clamp(16px, 2vw, 26px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.07);
    border-radius: 22px;
  }

  .hw-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
  }

  /* ------------------------------------------------------------ THE DOC */
  /* Overlaps the frame's top-left corner, so it reads as coming from outside
     the app rather than appearing inside it. */
  .hw-doc {
    position: absolute;
    z-index: 3;
    top: -13%;
    left: -9%;
    width: 47%;
    padding: 17px 18px 19px;
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 14px 30px rgba(20, 44, 130, 0.16);
    opacity: 0;
    overflow: hidden;
  }
  /* A turned corner, because a rectangle is not a document. */
  .hw-doc__fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 16px;
    height: 16px;
    background: var(--wash);
    clip-path: polygon(100% 0, 0 0, 100% 100%);
  }
  .hw-doc__name {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hw-doc__title {
    margin: 0 0 11px;
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--ink);
  }
  .hw-doc__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hw-doc__lines li {
    padding: 3px 5px;
    border-radius: 5px;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .hw-doc__scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 40%;
    opacity: 0;
    background: linear-gradient(
      180deg,
      rgba(53, 98, 245, 0) 0%,
      rgba(53, 98, 245, 0.18) 70%,
      rgba(53, 98, 245, 0.55) 97%,
      rgba(53, 98, 245, 0) 100%
    );
  }

  /* ------------------------------------------------------------ THE APP */
  .hw-app {
    position: absolute;
    inset: 0;
    background: var(--white);
    border-radius: 16px;
    box-shadow:
      0 2px 6px rgba(15, 27, 61, 0.06),
      0 22px 54px rgba(20, 44, 130, 0.18);
    overflow: hidden;
    opacity: 0;
  }
  .hw-app__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 15px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .hw-app__bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }
  .hw-app__bar p {
    margin: 0 0 0 10px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: -0.1px;
    color: var(--ink-faint);
  }
  .hw-app__body {
    position: relative;
    height: calc(100% - 39px);
  }
  .hw-screen {
    position: absolute;
    inset: 0;
    padding: 20px 24px;
    opacity: 0;
  }

  /* ACT 1 */
  .hw-zone {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 2px dashed var(--line);
    border-radius: 12px;
    color: var(--ink-faint);
  }
  .hw-zone svg {
    width: 38px;
    height: 38px;
  }
  .hw-zone p {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  /* ACT 2 */
  .hw-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }
  .hw-cards span {
    height: 52px;
    border-radius: 11px;
    background: var(--panel);
    border: 1.5px solid var(--line);
    opacity: 0;
  }
  .hw-made {
    margin: 0;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .hw-made b {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.8px;
    color: var(--blue);
    margin-right: 5px;
    font-variant-numeric: tabular-nums;
  }

  /* ACT 3 */
  .hw-stem {
    margin: 0 0 13px;
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--ink);
  }
  .hw-opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hw-opts li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 13px;
    border: 1.5px solid var(--line);
    border-radius: 11px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .hw-opt__mark {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--wash);
    color: #fff;
  }
  .hw-opt__mark svg {
    width: 13px;
    height: 13px;
  }
  .hw-meter {
    margin-top: 16px;
    opacity: 0;
  }
  .hw-meter__label {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-faint);
    margin-bottom: 6px;
  }
  .hw-meter__track {
    display: block;
    height: 8px;
    border-radius: 99px;
    background: var(--wash);
    overflow: hidden;
  }
  .hw-meter__track i {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 99px;
    background: var(--blue);
  }

  /* ---------------------------------------------------------- THE STEPS */
  .hw-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .hw-steps li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 2px;
    text-align: left;
  }
  .hw-steps__n {
    flex-shrink: 0;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.75);
    font-size: 11.5px;
    font-weight: 700;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .hw-steps__t {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.2px;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.3s ease;
  }
  /* The live step brightens rather than being boxed. Nothing gains an edge,
     so the frame above stays the only object on this side with a border. */
  .hw-steps li.is-on .hw-steps__n {
    background: #fff;
    color: var(--blue);
  }
  .hw-steps li.is-on .hw-steps__t {
    color: #fff;
  }

  @media (max-width: 1040px) {
    .hw {
      max-width: 620px;
    }
  }
</style>

<script>
  import { buildHowTimeline } from "../scripts/howTimeline.js";
  buildHowTimeline();
</script>
