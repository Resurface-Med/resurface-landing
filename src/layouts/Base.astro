---
const {
  title = "Resurface",
  description = "Spaced repetition for medical school.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3562f5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ------------------------------------------------------------------
     TOKENS

     Inverted from the first pass. Blue is now the field the page sits
     on, and white arrives as objects floating on it — the nav pill, the
     glass stat cards, the feature sheet. Sampled from the reference
     comp rather than from the logo, so this royal blue is brighter than
     the logo's #0140D2:

       #3562F5  the field      → --blue
       #A1C0FF  accent word    → --peri
       #F3F6FE  sheet white    → --panel
       #0F1B3D  text on white  → --ink

     Shadows are deliberately not a token colour — they're rgba of a
     navy that is darker than any blue here, so the floating objects
     read as lifted off the field rather than tinted by it.
     ------------------------------------------------------------------ */
  :root {
    --white: #ffffff;
    --panel: #f3f6fe;
    --wash: #e9eefd;

    --blue: #3562f5;
    --blue-deep: #2450e8;
    --peri: #a1c0ff;

    --ink: #0f1b3d;
    --ink-soft: #5a6485;
    --ink-faint: #8a93ae;

    --line: #e3e9f8;

    /* Frosted objects on the field. 0.10 is measured off the reference
       comp — low enough that the blurred backdrop, not the fill, is what
       you actually see. There is deliberately no companion line/border
       token: the comp's cards have no rim. */
    --glass: rgba(255, 255, 255, 0.1);
    --on-blue-soft: rgba(255, 255, 255, 0.78);

    --radius-pill: 999px;


    --wrap: 1180px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--blue);
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    background: var(--blue);
    color: var(--ink);
    /* Poppins — geometric, single-storey "a", circular bowls. Chosen to
       match the wordmark in the logo lockup. */
    font-family: "Poppins", -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* The UA rule for [hidden] is display:none at author-origin-beating
     strength only until something sets an explicit display. The demo's
     timer (grid) and due badge (inline-block) both do, so they stayed
     visible in Practice mode. */
  [hidden] {
    display: none !important;
  }

  img {
    max-width: 100%;
    display: block;
  }

  ::selection {
    background: var(--ink);
    color: #fff;
  }

  :focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    border-radius: 4px;
  }
  /* On the white sheet a white ring would be invisible. */
  .sheet :focus-visible,
  .rest :focus-visible {
    outline-color: var(--blue);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
