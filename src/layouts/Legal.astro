---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import Wave from "../components/Wave.astro";

const { title, updated, summary } = Astro.props;
---

<Base title={`${title} — Resurface`} description={summary}>
  <div class="legal-field">
    <header class="wrap legal-head">
      <nav class="legal-nav" aria-label="Site">
        <a class="legal-back" href="/">
          <img src="/logo-lockup-white.png" alt="Resurface home" width="560" height="131" />
        </a>
        <div class="legal-links">
          <a class="legal-pill" href="/"><span aria-hidden="true">←</span> Back to home</a>
          <a class={`legal-pill${title.startsWith("Privacy") ? " is-on" : ""}`} href="/privacy" aria-current={title.startsWith("Privacy") ? "page" : undefined}>Privacy</a>
          <a class={`legal-pill${title.startsWith("Terms") ? " is-on" : ""}`} href="/terms" aria-current={title.startsWith("Terms") ? "page" : undefined}>Terms</a>
        </div>
      </nav>
      <h1>{title}</h1>
      {summary && <p class="legal-lede">{summary}</p>}
      <p class="legal-updated">Last updated {updated}</p>
    </header>
  </div>

  <Wave from="var(--blue)" to="var(--white)" />

  <!-- The reading sheet. The page used to sit on the site's blue body with
       no surface under the text, so grey type landed on blue and could not
       be read (2026-10-18). -->
  <div class="legal-sheet">
    <main class="wrap legal-body">
      <slot />
      <a class="legal-home" href="/"><span aria-hidden="true">←</span> Back to Resurface</a>
    </main>
  </div>

  <Footer />
</Base>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .legal-field {
    background: var(--blue);
    padding: clamp(26px, 5vh, 44px) 0 clamp(18px, 3vh, 28px);
  }
  .legal-sheet {
    background: var(--white);
  }
  .legal-head {
    text-align: left;
  }
  .legal-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    flex-wrap: wrap;
  }
  .legal-links { display: flex; gap: 8px; flex-wrap: wrap; }
  .legal-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 14px; font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .legal-pill:hover { background: rgba(255, 255, 255, 0.24); }
  .legal-pill.is-on { background: #fff; color: var(--blue); }
  .legal-home {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: clamp(28px, 5vh, 44px);
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff !important;
    font-size: 15px; font-weight: 600;
    text-decoration: none !important;
  }
  .legal-back img {
    width: 132px;
    height: auto;
    display: block;
  }
  .legal-head h1 {
    margin: clamp(26px, 5vh, 42px) 0 0;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -1.6px;
    line-height: 1.05;
    color: #fff;
  }
  .legal-updated {
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--on-blue-soft);
  }
  .legal-lede {
    margin: 10px 0 0;
    max-width: 36em;
    font-size: 17px;
    line-height: 1.55;
    color: #fff;
  }

  .legal-body {
    padding-top: clamp(20px, 4vh, 40px);
    padding-bottom: clamp(48px, 8vh, 88px);
  }
</style>

<style is:global>
  /* Prose. Set once here so the documents themselves stay readable markup. */
  .legal-body h2 {
    margin: clamp(34px, 5vh, 48px) 0 12px;
    font-size: clamp(20px, 2.4vw, 25px);
    font-weight: 600;
    letter-spacing: -0.7px;
    color: var(--ink);
  }
  .legal-body h2:first-child {
    margin-top: 0;
  }
  .legal-body h3 {
    margin: 26px 0 8px;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--ink);
  }
  .legal-body p,
  .legal-body li {
    font-size: 16.5px;
    line-height: 1.7;
    color: #3d4766;
  }
  .legal-body p {
    margin: 0 0 14px;
  }
  .legal-body ul {
    margin: 0 0 16px;
    padding-left: 20px;
  }
  .legal-body li {
    margin-bottom: 8px;
  }
  .legal-body a {
    color: var(--blue);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-body strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* Anything the reader would regret skimming past. */
  .legal-callout {
    margin: 0 0 8px;
    padding: 20px 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .legal-callout p:last-child {
    margin-bottom: 0;
  }
  .legal-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 18px;
    font-size: 15px;
  }
  .legal-body th,
  .legal-body td {
    text-align: left;
    padding: 11px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--ink-soft);
  }
  .legal-body th {
    font-weight: 600;
    color: var(--ink);
    font-size: 14px;
    letter-spacing: 0;
    text-transform: none;
  }
  .legal-body td { font-size: 15px; line-height: 1.55; }
  .legal-body td:first-child { color: var(--ink); font-weight: 500; }
  /* Tables scroll on a phone rather than squeezing to one word a line. */
  .legal-table { overflow-x: auto; margin: 0 0 18px; }
  .legal-table table { margin: 0; min-width: 520px; }
</style>
