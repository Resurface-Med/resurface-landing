---
import Legal from "../layouts/Legal.astro";
const APP_URL = import.meta.env.PUBLIC_APP_URL || "https://app.tryresurface.com";
---

<!-- Vercel serves this for any address that does not exist, instead of its
     bare NOT_FOUND text: someone following an old or mistyped link still
     lands somewhere with a way in. Not indexed. -->
<Legal
  title="Page not found"
  summary="That page is not here. Resurface is a question bank for UK medical students."
  noindex
>
  <p>
    The link you followed may be old or mistyped. You can go to the
    <a href="/">Resurface home page</a>, or <a href={APP_URL}>start studying</a> straight away.
  </p>
</Legal>
