---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import HowDemo from "../components/HowDemo.astro";
import Wave from "../components/Wave.astro";
/* Nine real questions, one per deck, lifted from the question bank so the
   demo shows the actual product rather than a mock-up of it. */
import samples from "../data/sample-questions.json";

/* The card server-renders five option buttons and the script reuses them
   rather than rebuilding (Astro's scoped CSS wouldn't apply to generated
   nodes). That couples markup to data, so assert it at build time instead
   of shipping a question with a missing or orphaned option. */
const OPTS_PER_Q = 5;
if (samples.some((s) => s.opts.length !== OPTS_PER_Q)) {
  throw new Error(
    `sample-questions.json: every question needs exactly ${OPTS_PER_Q} options`
  );
}

const APP_URL = import.meta.env.PUBLIC_APP_URL || "https://app.tryresurface.com";

const subjects = [
  "Anatomy",
  "Biochemistry",
  "Embryology",
  "Genetics",
  "Histology",
  "Immunology",
  "Pathology",
  "Pharmacology",
  "Physiology",
];

const marquee = "Don't let the lecture sink. ";
---

<Base
  title="Resurface - practice questions for UK medical students"
  description="A question bank for UK medical students that follows the topics on your course, with AI that can write extra questions from your study material."
>
  <!-- Everything that animates in starts hidden, and only JS reveals it. If
       scripting is off, show it all immediately rather than a blank page. -->
  <noscript>
    <style>
      .hero-copy > *, .blob, [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
      .nav, .brand, .nav-links > *, .nav-cta {
        opacity: 1 !important;
        transform: none !important;
      }
      .ribbon { clip-path: none !important; }
    </style>
  </noscript>

  <!-- -------------------------------------------------------------- NAV -->
  <!-- Outside .field deliberately. A sticky element only sticks within its
       own container, and .field ends at the first wave. -->
  <header class="nav-wrap">
    <nav class="nav">
      <a class="brand" href="/">
        <img
          src="/logo-lockup.png"
          alt="Resurface"
          width="560"
          height="131"
          fetchpriority="high"
        />
      </a>

      <div class="nav-links">
        <a href="#subjects">Try a question</a>
        <a href="#ai">AI questions</a>
        <a href="#how">How it works</a>
      </div>

      <a class="nav-cta" href={APP_URL}>Start studying</a>
    </nav>
  </header>

  <!-- ================================================== THE BLUE FIELD -->
  <div class="field">
    <div class="blobs" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
    </div>

    <!-- ----------------------------------------------------------- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <!-- The subject is server-rendered as a real value, so the h1 says
             something meaningful with JS off and to a crawler. The animated
             span is hidden from assistive tech — a node whose text mutates
             every 85ms is unusable — and .vh carries the meaning. -->
        <h1>
          I want to study<br />
          <span class="typed">
            <span class="typed-out hl" aria-hidden="true">Pathology</span
            ><span class="caret" aria-hidden="true"></span>
            <span class="vh"
              >pathology, physiology, anatomy, and six more subjects.</span
            >
          </span>
        </h1>

        <p class="sub">
          A question bank for UK medical students — with AI that writes extra
          questions from your own lectures.
        </p>

        <div class="cta">
          <a class="btn-white" href={APP_URL}>Start studying <span>→</span></a>
          <a class="btn-ghost" href="#ai">See how AI helps</a>
        </div>

      </div>

      <div class="hero-demo">
        <HowDemo />
      </div>
    </section>

    <!-- --------------------------------------------------------- RIBBON -->
    <!-- A white ribbon across the blue, text riding its centreline. The
         path overshoots the viewBox on both sides so the band runs off
         screen rather than terminating at the edge. -->
    <!-- No preserveAspectRatio="none" here. Stretching the viewBox to a
         fixed CSS height scales x and y by different factors, and the
         glyphs get squashed with everything else. Uniform scale instead:
         width drives it, height follows from the viewBox aspect. -->
    <div class="ribbon" aria-hidden="true">
      <svg class="ribbon-curve" viewBox="0 0 1440 280">
        <path
          class="ribbon-fill"
          d="M-160,96 C160,8 520,8 800,96 C1080,184 1300,184 1600,96 L1600,188 C1300,276 1080,276 800,188 C520,100 160,100 -160,188 Z"
        ></path>
        <path
          id="ribbonline"
          fill="none"
          d="M-160,158 C160,70 520,70 800,158 C1080,246 1300,246 1600,158"
        ></path>
        <text class="ribbon-text">
          <textPath href="#ribbonline" startOffset="0%">
            {marquee.repeat(6)}
            <animate
              attributeName="startOffset"
              from="0%"
              to="-25%"
              dur="20s"
              repeatCount="indefinite"
            />
          </textPath>
        </text>
      </svg>
    </div>
  </div>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- =========================================== LIGHT: SUBJECTS/MODES -->
  <section class="light subjects-band" id="subjects">
    <div class="wrap">
      <div class="sub-head" data-reveal>
        <h2 class="section-h">Go on, have a go.</h2>
      </div>

      <div class="subj-pick">
        <label class="subj-pick-label" for="subj-select">Subject</label>
        <div class="subj-select-wrap">
          <select id="subj-select" class="subj-select" aria-controls="qcard">
            {
              subjects.map((s, i) => (
                <option value={i} selected={i === 0}>
                  {s}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- Question 0 is server-rendered in full, so the card reads and
           looks right with JS off; the script only swaps its contents. -->
      <div class="qcard" id="qcard">
        <span class="qtopic" data-topic>{samples[0].topic}</span>

        <h3 class="qstem" data-stem>{samples[0].q}</h3>

        <ul class="opts" data-opts>
          {
            samples[0].opts.map((o, i) => (
              <li>
                <button class="opt" type="button" data-o={i}>
                  <span class="opt-k">{String.fromCharCode(65 + i)}</span>
                  <span class="opt-t">{o}</span>
                </button>
              </li>
            ))
          }
        </ul>

        <p class="verdict" data-verdict role="status" aria-live="polite"></p>
        <div class="exp" data-exp hidden></div>

        <div class="qfoot">
          <button class="next" type="button" data-next hidden>
            Next subject <span aria-hidden="true">→</span>
          </button>
          <a class="qfoot-cta" href={APP_URL}>
            Start studying <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ samples }}>
    window.__RS_SAMPLES = samples;
  </script>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <div class="band-gap band-gap--blue" aria-hidden="true"></div>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ============================================== LIGHT: AI GENERATE -->
  <section class="light ai-band" id="ai">
    <div class="wrap">
      <div class="ai-layout">
        <div class="ai-intro" data-reveal>
          <h2 class="ai-heading section-h">
            Most question banks miss the details in your lectures.
          </h2>
          <p class="ai-solve">
            Upload your lectures to Resurface, and it writes questions that
            don’t miss those details.
          </p>
        </div>

        <div
          class="ai-stage"
          id="ai-stage"
          aria-label="Demo: upload a lecture and get AI questions"
        >
        <article class="ai-panel">
          <div class="upload-row" data-upload>
            <div class="file-chip" aria-hidden="true">
              <span class="file-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <path
                    d="M7 3.5h7.2L19 8.3V20a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 20V5A1.5 1.5 0 0 1 7.5 3.5"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linejoin="round"></path>
                  <path
                    d="M14 3.5V8h4.8"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="file-meta">
                <span class="file-name">Physiology · Blood glucose.pdf</span>
                <span class="file-sub">Your lecture slides</span>
              </span>
            </div>
            <div class="upload-hint" data-upload-hint>Drop in a lecture</div>
          </div>

          <div class="ai-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-pill">
              <img
                src="/books.webp"
                alt=""
                width="40"
                height="40"
                class="ai-bridge-mark"
              />
              <span class="ai-bridge-name">Resurface</span>
              <span class="ai-bridge-status" data-ai-status>Waiting…</span>
            </span>
            <span class="ai-bridge-line"></span>
          </div>

          <div class="ai-progress" data-progress aria-hidden="true">
            <span class="ai-progress-bar" data-progress-bar></span>
          </div>

          <div class="ready-card" data-ready>
            <div class="ready-top">
              <span class="ready-count" data-ready-count>0</span>
              <span class="ready-label">questions ready</span>
            </div>
            <div class="ready-reveal" data-preview>
              <div class="ready-preview">
                <p class="ready-stem">
                  Which hormone lowers blood glucose?
                </p>
                <div class="ready-opts">
                  <span>Glucagon</span>
                  <span class="right">Insulin</span>
                  <span>Adrenaline</span>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
      </div>
    </div>
  </section>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ============================================= BLUE: WHY IT WORKS -->
  <!-- One question. Three attempts. Hand → known. -->
  <section class="why">
    <div class="wrap why-grid">
      <div class="why-copy-block" data-reveal>
        <h2>It gets easier.</h2>
        <p class="why-lead">
          Miss a question and it comes back in a few days. Get it right and it
          waits longer. You spend your time on what still needs work.
        </p>
      </div>

      <figure
        class="why-proof"
        data-reveal
        aria-label="The same question three times. First you guess wrong. Then you get it. Later you just know 7.4."
      >
        <p class="proof-stem">Normal arterial blood pH is approximately:</p>

        <ol class="proof-beats">
          <li class="proof-beat is-messy" style="--i: 0">
            <span class="proof-label">First try</span>
            <p class="proof-line" aria-hidden="true">
              <span class="ink wrong">7.0</span>
              <span class="ink wrong is-soft">7.8</span>
              <span class="ink unsure">?</span>
            </p>
          </li>

          <li class="proof-beat is-settling" style="--i: 1">
            <span class="proof-label">A few days later</span>
            <p class="proof-line" aria-hidden="true">
              <span class="ink wrong is-faint">7.0</span>
              <span class="ink right is-hand">7.4</span>
              <span class="ink wrong is-faint">7.8</span>
            </p>
          </li>

          <li class="proof-beat is-known" style="--i: 2">
            <span class="proof-label">Once you know it</span>
            <p class="proof-line" aria-hidden="true">
              <span class="ink right is-typed">7.4</span>
            </p>
          </li>
        </ol>
      </figure>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- The gap itself. Waves are edges; without a band between them there is
       nothing for the two curves to bound. -->
  <div class="band-gap" aria-hidden="true"></div>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ------------------------------------------------------------ CLOSER -->
  <section class="closer">
    <div class="wrap closer-inner" data-reveal>
      <h2>Built for med students, by a med student.</h2>
      <p>
        For students who revise best under mild panic. Free while it's in
        testing.
      </p>
      <a class="btn-white big" href={APP_URL}>Start studying <span>→</span></a>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ---------------------------------------------------------- COLOPHON -->
  <!-- The last thing on the site is the word it is named after, given a page
       of its own rather than a corner of the footer. The definition is the
       argument the product makes, so it is allowed to be the size of one. -->
  <section class="colophon">
    <div class="wrap">
      <h2 class="col-word">resurface</h2>

      <p class="col-pron"><span class="ipa">/ˌriːˈsəːfɪs/</span> <span class="pos">verb</span></p>

      <p class="col-senses"><b>1</b> to rise back up to the surface. <b>2</b> to bring a thing back into view <em class="key">just before it is lost</em>: <i>material resurfaces the day before you would have forgotten it.</i></p>

      <p class="col-etym"><span class="lbl">origin</span> <i>from</i> <b>re-</b> <i>‘again’</i> + <b>surface</b>, <i>from Latin</i> superficies <i>‘upper face’.</i></p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ================================================================ FIELD */
  .field {
    position: relative;
    background: var(--blue);
    isolation: isolate;
    padding-bottom: 8px;
  }
  .field > *:not(.blobs) {
    position: relative;
    z-index: 1;
  }

  .blobs {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .blob {
    position: absolute;
    display: block;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 58% 42% 47% 53% / 45% 51% 49% 55%;
  }
  .b1 {
    width: 640px;
    height: 560px;
    top: 40px;
    right: -120px;
  }
  .b2 {
    width: 520px;
    height: 480px;
    top: 320px;
    right: 260px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%;
  }
  .b3 {
    width: 420px;
    height: 400px;
    top: 620px;
    right: -60px;
    background: rgba(255, 255, 255, 0.045);
  }

  /* ------------------------------------------------------------------ NAV */
  /* No background on the wrapper. It used to be painted blue, which meant
     a blue strip travelled down the page with the nav and sat on top of
     the white sections. The pill floats on whatever is behind it. */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 18px 24px 0;
    pointer-events: none; /* the 18px gutter shouldn't eat clicks */
    transition: padding 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-wrap.is-stuck {
    padding-top: 10px;
  }
  .nav-wrap.is-stuck .nav {
    box-shadow: 0 10px 30px rgba(15, 30, 90, 0.16);
  }
  .nav {
    pointer-events: auto;
    max-width: var(--wrap);
    margin: 0 auto;
    /* Slightly translucent with a blur, so content passing underneath is felt
       rather than hidden — the pill stops looking like a solid bar laid on top
       of the page. */
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    /* A white pill on the blue field separates itself. Over .light
       (#F3F6FE) it is white-on-almost-white, so it carries its own edge:
       a hairline plus a tight contact shadow under the big soft one. */
    border: 1px solid rgba(15, 27, 61, 0.08);
    border-radius: var(--radius-pill);
    box-shadow:
      0 1px 2px rgba(15, 27, 61, 0.05),
      0 8px 24px rgba(20, 44, 130, 0.1);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 8px 8px 8px 22px;
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }
  .brand {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .brand img {
    width: 148px;
    height: auto;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  /* Links sit in their own hit areas rather than floating as bare text, so the
     row reads as controls and the target is a comfortable size. */
  .nav-links a {
    position: relative;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    transition: color 0.16s ease, background-color 0.16s ease;
  }
  .nav-links a:hover {
    color: var(--ink);
    background: var(--wash);
  }
  /* Marks the section you are actually looking at. */
  .nav-links a.is-current {
    color: var(--blue);
    background: var(--wash);
    font-weight: 600;
  }
  .nav-cta {
    background: var(--blue);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .nav-cta:hover {
    background: var(--blue-deep);
    transform: translateY(-1px);
  }

  /* ----------------------------------------------------------------- HERO */
  /* The claim on the left, the thing happening on the right. The demo takes
     the larger share — it is the explanation, not an illustration of one. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(32px, 5vw, 76px);
    padding-top: clamp(64px, 9vh, 104px);
    padding-bottom: clamp(32px, 5vh, 60px);
  }
  .hero-copy {
    max-width: 480px;
  }
  .hero-demo {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  h1 {
    color: #fff;
    font-size: clamp(36px, 4.4vw, 58px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -2.2px;
  }
  .hl {
    color: var(--peri);
  }

  /* The zero-width space is load-bearing: the word empties to "" between
     subjects, and an empty inline box drops the line height to the caret's,
     which walked everything below it up and down on every cycle. */
  .typed {
    display: inline-block;
  }
  .typed::before {
    content: "\200B";
  }
  .caret {
    display: inline-block;
    width: 0.055em;
    height: 0.72em;
    background: var(--peri);
    margin-left: 0.07em;
    vertical-align: -0.02em;
    animation: caret-blink 1.05s steps(1, end) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .sub {
    margin-top: 24px;
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--on-blue-soft);
    max-width: 470px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .btn-white,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 16px 32px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 600;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .btn-white {
    background: #fff;
    color: var(--blue);
    box-shadow: 0 12px 30px rgba(20, 44, 130, 0.22);
  }
  .btn-white span {
    transition: transform 0.18s ease;
  }
  .btn-white:hover {
    transform: translateY(-2px);
  }
  .btn-white:hover span {
    transform: translateX(4px);
  }
  .btn-white.big {
    padding: 18px 38px;
    font-size: 18px;
  }
  .btn-ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }


  /* ---------------------------------------------------------------- STAGE */
  /* The copy had no entrance at all — it was simply present, while the books
     faded up beside it. Each line now clears from blur in sequence, so the
     headline arrives rather than appears. Driven by a class set on load, not
     on scroll: the hero is already in view. */
  .hero-copy > * {
    opacity: 0;
    transform: translateY(26px);
    filter: blur(10px);
  }
  .hero.is-ready .hero-copy > * {
    animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero.is-ready .hero-copy > *:nth-child(1) { animation-delay: 0.05s; }
  .hero.is-ready .hero-copy > *:nth-child(2) { animation-delay: 0.16s; }
  .hero.is-ready .hero-copy > *:nth-child(3) { animation-delay: 0.27s; }
  .hero.is-ready .hero-copy > *:nth-child(4) { animation-delay: 0.36s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(26px); filter: blur(10px); }
    to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
  }



  /* Blobs drift up to size behind everything, slowly enough to read as depth
     rather than as an element arriving. */
  .blob {
    opacity: 0;
    transform: scale(0.86);
  }
  .field.is-ready .blob {
    animation: blob-in 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .field.is-ready .b2 { animation-delay: 0.12s; }
  .field.is-ready .b3 { animation-delay: 0.22s; }
  @keyframes blob-in {
    from { opacity: 0; transform: scale(0.86); }
    to   { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .blob {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none !important;
    }
  }


  /* --------------------------------------------------- NAV + RIBBON ENTRY */
  /* The nav drops in as one piece and its contents follow, so the pill reads
     as an object arriving rather than three things fading. */
  .nav {
    opacity: 0;
    transform: translateY(-18px) scale(0.97);
    /* Safety net: if the class never lands, the nav still appears. */
    animation: nav-failsafe 0.01s linear 1.6s forwards;
  }
  @keyframes nav-failsafe {
    to { opacity: 1; transform: none; }
  }
  .nav-wrap.is-ready .nav {
    animation: nav-drop 0.7s cubic-bezier(0.34, 1.32, 0.5, 1) both;
  }
  @keyframes nav-drop {
    from { opacity: 0; transform: translateY(-18px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .brand,
  .nav-links > *,
  .nav-cta {
    opacity: 0;
    animation: nav-failsafe 0.01s linear 1.6s forwards;
  }
  .nav-wrap.is-ready .brand,
  .nav-wrap.is-ready .nav-links > *,
  .nav-wrap.is-ready .nav-cta {
    animation: nav-item 0.45s ease both;
  }
  .nav-wrap.is-ready .brand      { animation-delay: 0.22s; }
  .nav-wrap.is-ready .nav-links > *:nth-child(1) { animation-delay: 0.28s; }
  .nav-wrap.is-ready .nav-links > *:nth-child(2) { animation-delay: 0.33s; }
  .nav-wrap.is-ready .nav-links > *:nth-child(3) { animation-delay: 0.38s; }
  .nav-wrap.is-ready .nav-cta    { animation-delay: 0.44s; }
  @keyframes nav-item {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* The ribbon unrolls: clipped to nothing, then opened out from the centre,
     which suits a band of text that is already travelling sideways. */
  .ribbon {
    clip-path: inset(0 50% 0 50%);
  }
  .field.is-ready .ribbon {
    animation: ribbon-unroll 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }
  @keyframes ribbon-unroll {
    from { clip-path: inset(0 50% 0 50%); }
    to   { clip-path: inset(0 0 0 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .brand,
    .nav-links > *,
    .nav-cta {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
    .ribbon { clip-path: none; }
  }

  /* ------------------------------------------------- SCROLL REVEAL (generic) */
  [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    filter: blur(7px);
    transition:
      opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal].is-vis {
    opacity: 1;
    transform: none;
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  /* --------------------------------------------------------------- RIBBON */
  .ribbon {
    line-height: 0;
    margin-top: clamp(28px, 5vh, 56px);
    overflow: hidden;
  }
  .ribbon-curve {
    width: 100%;
    height: auto;
    display: block;
  }
  .ribbon-fill {
    fill: #fff;
  }
  /* In viewBox units. Keep under ~80 — baseline is y=158 and the band
     top is ~96, so bigger glyphs punch through the white. */
  .ribbon-text {
    fill: var(--blue);
    font-family: "Poppins", sans-serif;
    font-size: 46px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  /* Mobile: show the full curve with readable type. Avoid scaleY — it
     squashes the glyphs. A modest width bump is enough. */
  @media (max-width: 700px) {
    .hero {
      padding-bottom: 8px;
    }
    .field {
      padding-bottom: 16px;
    }
    .ribbon {
      margin-top: 12px;
      overflow: hidden;
    }
    .ribbon-curve {
      width: 150%;
      max-width: none;
      margin-left: -25%;
    }
  }

  @media (max-width: 400px) {
    .ribbon-curve {
      width: 160%;
      margin-left: -30%;
    }
  }

  /* ================================================================ LIGHT */
  /* flow-root, not plain block. .stats carries a bottom margin, and with
     no bottom padding here that margin collapses straight out of the
     section — and because body is blue, the escaped margin painted as a
     blue stripe between the light content and the wave. A block
     formatting context keeps child margins inside. */
  .light {
    background: var(--panel);
    display: flow-root;
  }

  .section-h {
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 600;
    letter-spacing: -1.1px;
    line-height: 1.16;
    color: var(--ink);
  }

  .pill {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--blue);
    background: var(--wash);
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }
  .pill.on-blue {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  /* --------------------------------------------------------- HOW IT WORKS */
  .how {
    padding: clamp(52px, 9vh, 96px) 0 clamp(48px, 7vh, 84px);
    scroll-margin-top: 100px;
  }
  .head {
    text-align: center;
    margin-bottom: clamp(36px, 6vh, 64px);
  }
  .how-lead {
    margin: 12px auto 0;
    max-width: 24em;
    font-size: clamp(16px, 1.7vw, 19px);
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* ------------------------------------------------------------------ WHY */
  /* One question, three attempts. Hand → known. No timeline chrome. */
  .why {
    background: var(--blue);
    color: #fff;
    padding: clamp(40px, 6vh, 72px) 0;
    position: relative;
    overflow: hidden;
  }
  .why::before {
    content: "";
    position: absolute;
    width: min(560px, 70vw);
    height: min(560px, 70vw);
    right: -14%;
    top: 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(161, 192, 255, 0.2) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .why-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .why-copy-block {
    max-width: 32em;
  }
  .why-copy-block h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    letter-spacing: -1.2px;
    line-height: 1.08;
  }
  .why-lead {
    margin: 0;
    font-size: clamp(16px, 1.55vw, 18.5px);
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.45;
    color: #fff;
  }

  .why-proof {
    margin: 0;
    max-width: 28em;
  }

  .proof-stem {
    margin: 0 0 22px;
    font-size: clamp(16px, 1.55vw, 18px);
    font-weight: 500;
    letter-spacing: -0.25px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.92);
  }

  .proof-beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .proof-beat {
    display: grid;
    grid-template-columns: minmax(7.5em, 9.5em) minmax(0, 1fr);
    gap: 12px 16px;
    align-items: baseline;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 90ms + 40ms);
  }
  .why-proof.is-vis .proof-beat {
    opacity: 1;
    transform: none;
  }

  .proof-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.1px;
    color: rgba(255, 255, 255, 0.55);
    padding-top: 0.35em;
  }

  .proof-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em 0.9em;
  }

  .ink {
    position: relative;
    display: inline-block;
    line-height: 1;
  }

  /* First try — messy guesses */
  .is-messy .ink {
    font-family: "Caveat", cursive;
    font-weight: 600;
    font-size: clamp(28px, 3.2vw, 36px);
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.92);
    transform: rotate(-2deg);
  }
  .is-messy .ink:nth-child(2) {
    transform: rotate(1.5deg);
  }
  .is-messy .ink:nth-child(3) {
    transform: rotate(-3deg);
    opacity: 0.7;
  }
  .is-messy .ink.wrong {
    text-decoration: line-through;
    text-decoration-thickness: 2.5px;
    text-decoration-color: rgba(255, 255, 255, 0.75);
  }
  .is-messy .ink.is-soft {
    opacity: 0.45;
  }
  .is-messy .ink.unsure {
    opacity: 0.55;
  }

  /* A few days later — wrongs fade, answer still hand-like */
  .is-settling .ink.wrong {
    font-family: "Caveat", cursive;
    font-weight: 600;
    font-size: clamp(22px, 2.4vw, 28px);
    color: rgba(255, 255, 255, 0.5);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .is-settling .ink.is-faint {
    opacity: 0.32;
  }
  .is-settling .ink.right.is-hand {
    font-family: "Caveat", cursive;
    font-weight: 700;
    font-size: clamp(32px, 3.6vw, 42px);
    color: #fff;
    transform: rotate(-0.8deg);
  }

  /* Once you know it — just the answer, typed */
  .is-known .ink.right.is-typed {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -1.2px;
    color: #fff;
  }

  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      align-items: start;
    }
    .why-copy-block {
      max-width: 36em;
    }
    .why-proof {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .why {
      padding: 36px 0;
    }
    .why-copy-block h2 {
      margin-bottom: 10px;
    }
    .why-proof {
      text-align: center;
      margin-inline: auto;
      max-width: 22em;
    }
    .proof-stem {
      margin: 0 auto 26px;
      font-size: clamp(20px, 5.6vw, 24px);
      font-weight: 600;
      letter-spacing: -0.4px;
      line-height: 1.3;
      max-width: 16em;
    }
    .proof-beats {
      gap: 22px;
      justify-items: center;
    }
    .proof-beat {
      grid-template-columns: 1fr;
      gap: 6px;
      justify-items: center;
      width: 100%;
    }
    .proof-label {
      padding-top: 0;
      font-size: 13px;
    }
    .proof-line {
      justify-content: center;
    }
    .is-messy .ink {
      font-size: clamp(34px, 9vw, 42px);
    }
    .is-settling .ink.wrong {
      font-size: clamp(26px, 7vw, 32px);
    }
    .is-settling .ink.right.is-hand {
      font-size: clamp(40px, 11vw, 48px);
    }
    .is-known .ink.right.is-typed {
      font-size: clamp(44px, 12vw, 56px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-beat {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ------------------------------------------------------------- SUBJECTS */
  .subjects-band {
    padding: clamp(32px, 5vh, 56px) 0 clamp(48px, 8vh, 88px);
    scroll-margin-top: 100px;
  }
  .subjects-band .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sub-head {
    max-width: 640px;
    width: 100%;
    text-align: center;
  }

  .subj-pick {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    width: 100%;
    max-width: 640px;
  }
  .subj-pick-label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.15px;
    color: var(--ink-soft);
  }
  .subj-select-wrap {
    position: relative;
    min-width: min(240px, 100%);
  }
  .subj-select-wrap::after {
    content: "";
    position: absolute;
    right: 16px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }
  .subj-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    font: inherit;
    cursor: pointer;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(20, 44, 130, 0.05);
    border-radius: var(--radius-pill);
    padding: 11px 42px 11px 18px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--ink);
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .subj-select:hover {
    border-color: #c5d3f5;
  }
  .subj-select:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow:
      0 0 0 3px rgba(53, 98, 245, 0.15),
      0 2px 8px rgba(20, 44, 130, 0.05);
  }

  /* ----------------------------------------------------------- Q CARD */
  .qcard {
    position: relative;
    margin-top: clamp(18px, 3vh, 26px);
    max-width: 640px;
    width: 100%;
    background: var(--white);
    border-radius: 28px;
    box-shadow:
      0 4px 16px rgba(20, 44, 130, 0.04),
      0 24px 56px rgba(20, 44, 130, 0.1);
    padding: clamp(22px, 3vw, 30px);
  }
  .qcard.shake {
    animation: shake 0.36s ease;
  }
  @keyframes shake {
    20% {
      transform: translateX(-6px);
    }
    45% {
      transform: translateX(5px);
    }
    70% {
      transform: translateX(-3px);
    }
    100% {
      transform: translateX(0);
    }
  }
  .qcard.swap .qstem,
  .qcard.swap .opts {
    animation: deal 0.32s ease;
  }
  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(8px) rotate(-0.6deg);
    }
  }

  .qtopic {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.1px;
    color: var(--ink-faint);
  }

  .qstem {
    margin-top: 12px;
    font-size: clamp(18px, 2vw, 23px);
    font-weight: 600;
    letter-spacing: -0.6px;
    line-height: 1.28;
    color: var(--ink);
    max-width: 46ch;
  }
  .opts {
    list-style: none;
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }
  .opt {
    font: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1.5px solid transparent;
    border-radius: 999px;
    padding: 11px 16px;
    font-size: 15px;
    color: var(--ink);
    transition: background 0.16s ease, border-color 0.16s ease,
      transform 0.16s ease, box-shadow 0.16s ease;
  }
  .opt:hover:not(:disabled) {
    border-color: rgba(53, 98, 245, 0.35);
    background: #fff;
    box-shadow: 0 4px 14px rgba(20, 44, 130, 0.07);
    transform: translateY(-1px);
  }
  .opt:disabled {
    cursor: default;
  }
  .opt-k {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--white);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink-faint);
  }
  .opt.right {
    background: #e7f6ed;
    border-color: #1f9d55;
  }
  .opt.right .opt-k {
    background: #1f9d55;
    color: #fff;
  }
  .opt.wrong {
    background: #fdeaea;
    border-color: #d64545;
  }
  .opt.wrong .opt-k {
    background: #d64545;
    color: #fff;
  }

  .verdict {
    margin-top: 12px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .verdict:empty {
    display: none;
  }
  .exp {
    margin-top: 8px;
    background: var(--panel);
    border-radius: 18px;
    padding: 14px 16px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  /* :global because the <b> here is created by the script, so it carries
     no scope attribute and a plain `.exp b` rule would never match it. */
  .exp :global(b) {
    color: var(--ink);
    font-weight: 700;
  }

  .qfoot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .next {
    font: inherit;
    cursor: pointer;
    border: 1.5px solid var(--line);
    background: var(--white);
    border-radius: var(--radius-pill);
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    transition: all 0.18s ease;
  }
  .next:hover {
    border-color: var(--blue);
    color: var(--blue);
  }
  .qfoot-cta {
    background: var(--blue);
    color: #fff;
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .qfoot-cta:hover {
    background: var(--blue-deep);
    transform: translateY(-1px);
  }

  /* ---------------------------------------------------------- AI SECTION */
  .ai-band {
    padding: clamp(56px, 9vh, 96px) 0 clamp(44px, 6vh, 72px);
    scroll-margin-top: 100px;
    border-top: 1px solid var(--line);
  }
  .ai-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.95fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }
  .ai-intro {
    text-align: left;
  }
  .ai-heading {
    margin: 0;
  }
  .ai-solve {
    margin: 18px 0 0;
    max-width: 22em;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    letter-spacing: -0.5px;
    line-height: 1.35;
    color: var(--blue);
  }

  .ai-stage {
    margin: 0;
    min-width: 0;
    width: 100%;
    /* Set from the measured expanded height; 0 until then, so nothing is
       reserved if the script never runs. */
    min-height: var(--ai-stage-min, 0px);
  }

  /* Measuring pose: fully open, with every transition off so nothing animates
     while we read the height. */
  .ai-panel.is-measuring,
  .ai-panel.is-measuring * {
    transition: none !important;
    animation: none !important;
  }
  .ai-panel.is-measuring .ready-reveal {
    grid-template-rows: 1fr;
  }
  .ai-panel.is-measuring .ready-preview {
    opacity: 1;
    margin-top: 14px;
    padding-top: 14px;
  }
  .ai-panel {
    background:
      radial-gradient(
        120% 80% at 50% -10%,
        rgba(161, 192, 255, 0.45) 0%,
        transparent 55%
      ),
      linear-gradient(180deg, #eef3ff 0%, #ffffff 48%);
    border-radius: 28px;
    padding: clamp(18px, 2.5vw, 26px);
    box-shadow:
      0 4px 14px rgba(20, 44, 130, 0.04),
      0 22px 48px rgba(20, 44, 130, 0.1);
  }

  @media (max-width: 860px) {
    .ai-layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .ai-solve {
      max-width: none;
    }
    .ai-stage {
      max-width: 440px;
      margin-inline: auto;
    }
  }

  .upload-row {
    position: relative;
    min-height: 72px;
    display: grid;
    place-items: center;
  }
  .file-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 14px 16px;
    box-shadow: 0 10px 28px rgba(20, 44, 130, 0.06);
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    pointer-events: none;
  }
  .ai-stage.has-file .file-chip {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .file-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--wash);
    color: var(--blue);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .file-meta {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .file-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.25px;
    color: var(--ink);
  }
  .file-sub {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-faint);
  }
  .upload-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1.5px dashed #c5d3f5;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.55);
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.15px;
    transition: opacity 0.3s ease;
  }
  .ai-stage.has-file .upload-hint {
    opacity: 0;
    pointer-events: none;
  }

  .ai-bridge {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 18px 0 12px;
  }
  .ai-bridge-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(53, 98, 245, 0.35),
      transparent
    );
  }
  .ai-bridge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    border: 1px solid #d7e2ff;
    border-radius: var(--radius-pill);
    padding: 7px 14px 7px 8px;
    box-shadow: 0 8px 20px rgba(20, 44, 130, 0.08);
    white-space: nowrap;
  }
  .ai-bridge-mark {
    width: 22px;
    height: 22px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }
  .ai-bridge-name,
  .ai-bridge-status {
    font-size: 13px;
    font-weight: 700;
