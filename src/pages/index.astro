    border-radius: var(--radius-pill);
    padding: 10px 21px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--ink);
    transition: all 0.18s ease;
  }
  .chips li:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  /* --------------------------------------------------------------- MODES */
  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 18px;
    padding-bottom: clamp(56px, 8vh, 88px);
