---
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
/* Nine real questions, one per deck, lifted from the question bank so the
   demo shows the actual product rather than a mock-up of it. */
import samples from "../data/sample-questions.json";

/* The card server-renders five option buttons and the script reuses them
   rather than rebuilding (Astro's scoped CSS wouldn't apply to generated
   nodes). That couples markup to data, so assert it at build time instead
   of shipping a question with a missing or orphaned option. */
const OPTS_PER_Q = 5;
if (samples.some((s) => s.opts.length !== OPTS_PER_Q)) {
  throw new Error(
    `sample-questions.json: every question needs exactly ${OPTS_PER_Q} options`
  );
}

const APP_URL = import.meta.env.PUBLIC_APP_URL || "#";

const steps = [
  {
    n: "1",
    art: "answer",
    title: "Practise from the bank",
    body: "Work through multiple-choice questions across the subjects on your course. Five options, one right.",
  },
  {
    n: "2",
    art: "generate",
    title: "Generate more when you need it",
    body: "Upload or paste your own lecture material and AI writes questions that cover the details generic banks often skip.",
  },
  {
    n: "3",
    art: "track",
    title: "Spend time where you're weak",
    body: "Resurface keeps a record of what you're struggling with, so later sessions lean into those topics.",
  },
];

const subjects = [
  "Anatomy",
  "Biochemistry",
  "Embryology",
  "Genetics",
  "Histology",
  "Immunology",
  "Pathology",
  "Pharmacology",
  "Physiology",
];

const marquee = "Resurface it. Just before it sinks. ";
---

<Base
  title="Resurface — practice questions for UK medical students"
  description="A question bank for UK medical students that follows the topics on your course, with AI that can write extra questions from your study material."
>
  <!-- -------------------------------------------------------------- NAV -->
  <!-- Outside .field deliberately. A sticky element only sticks within its
       own container, and .field ends at the first wave. -->
  <header class="nav-wrap">
    <nav class="nav">
      <a class="brand" href="/">
        <img
          src="/logo-lockup.png"
          alt="Resurface"
          width="560"
          height="131"
          fetchpriority="high"
        />
      </a>

      <div class="nav-links">
        <a href="#subjects">Try a question</a>
        <a href="#ai">AI questions</a>
        <a href="#how">How it works</a>
      </div>

      <a class="nav-cta" href={APP_URL}>Start studying</a>
    </nav>
  </header>

  <!-- ================================================== THE BLUE FIELD -->
  <div class="field">
    <div class="blobs" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
    </div>

    <!-- ----------------------------------------------------------- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <!-- The subject is server-rendered as a real value, so the h1 says
             something meaningful with JS off and to a crawler. The animated
             span is hidden from assistive tech — a node whose text mutates
             every 85ms is unusable — and .vh carries the meaning. -->
        <h1>
          I want to study<br />
          <span class="typed">
            <span class="typed-out hl" aria-hidden="true">Pathology</span
            ><span class="caret" aria-hidden="true"></span>
            <span class="vh"
              >pathology, physiology, anatomy, and six more subjects.</span
            >
          </span>
        </h1>

        <p class="sub">
          A question bank for UK medical students that closely follows the
          topics on your course. AI sits alongside it and can write extra
          questions from your own study material.
        </p>

        <div class="cta">
          <a class="btn-white" href={APP_URL}>Start studying <span>→</span></a>
          <a class="btn-ghost" href="#ai">See how AI helps</a>
        </div>

        <p class="note">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="9" fill="rgba(255,255,255,.22)"></circle>
            <path
              d="M6 10.2l2.6 2.6L14 7.4"
              fill="none"
              stroke="#fff"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Free while it's in testing.
        </p>
      </div>

      <div class="stage">
        <img
          class="books"
          src="/books.webp"
          alt="Two stacked textbooks"
          width="580"
          height="839"
        />

        <div class="chip chip-streak">
          <span class="chip-label">Streak</span>
          <span class="chip-value">12 <em>days</em></span>
          <svg class="bars" viewBox="0 0 124 32" aria-hidden="true">
            <g fill="#fff">
              <rect x="0" y="22" width="14" height="10" rx="4" opacity=".55"
              ></rect>
              <rect x="22" y="18" width="14" height="14" rx="4" opacity=".64"
              ></rect>
              <rect x="44" y="14" width="14" height="18" rx="4" opacity=".73"
              ></rect>
              <rect x="66" y="9" width="14" height="23" rx="4" opacity=".82"
              ></rect>
              <rect x="88" y="5" width="14" height="27" rx="4" opacity=".91"
              ></rect>
              <rect x="110" y="0" width="14" height="32" rx="4"></rect>
            </g>
          </svg>
        </div>

        <div class="chip chip-acc">
          <span class="chip-value big">84%</span>
          <span class="chip-label">Accuracy</span>
          <span class="bar"><i style="width:84%"></i></span>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- RIBBON -->
    <!-- A white ribbon across the blue, text riding its centreline. The
         path overshoots the viewBox on both sides so the band runs off
         screen rather than terminating at the edge. -->
    <!-- No preserveAspectRatio="none" here. Stretching the viewBox to a
         fixed CSS height scales x and y by different factors, and the
         glyphs get squashed with everything else. Uniform scale instead:
         width drives it, height follows from the viewBox aspect. -->
    <div class="ribbon" aria-hidden="true">
      <svg viewBox="0 0 1440 250">
        <path
          class="ribbon-fill"
          d="M-160,96 C160,8 520,8 800,96 C1080,184 1300,184 1600,96 L1600,188 C1300,276 1080,276 800,188 C520,100 160,100 -160,188 Z"
        ></path>
        <path
          id="ribbonline"
          fill="none"
          d="M-160,158 C160,70 520,70 800,158 C1080,246 1300,246 1600,158"
        ></path>
        <text class="ribbon-text">
          <textPath href="#ribbonline" startOffset="0%">
            {marquee.repeat(6)}
            <animate
              attributeName="startOffset"
              from="0%"
              to="-25%"
              dur="24s"
              repeatCount="indefinite"
            />
          </textPath>
        </text>
      </svg>
    </div>
  </div>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- =========================================== LIGHT: SUBJECTS/MODES -->
  <section class="light subjects-band" id="subjects">
    <div class="wrap">
      <div class="sub-head">
        <h2 class="section-h">Go on, have a go.</h2>
      </div>

      <!-- Real buttons in a tablist, not <li>s — they drive the card
           below, so they have to be reachable and announce state. -->
      <div class="chips" role="tablist" aria-label="Choose a subject">
        {
          subjects.map((s, i) => (
            <button
              class:list={["subj", { on: i === 0 }]}
              role="tab"
              type="button"
              id={`tab-${i}`}
              aria-controls="qcard"
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-i={i}
            >
              {s}
            </button>
          ))
        }
      </div>

      <!-- Question 0 is server-rendered in full, so the card reads and
           looks right with JS off; the script only swaps its contents. -->
      <div
        class="qcard"
        id="qcard"
        role="tabpanel"
        aria-labelledby="tab-0"
      >
        <span class="qtopic" data-topic>{samples[0].topic}</span>

        <h3 class="qstem" data-stem>{samples[0].q}</h3>

        <ul class="opts" data-opts>
          {
            samples[0].opts.map((o, i) => (
              <li>
                <button class="opt" type="button" data-o={i}>
                  <span class="opt-k">{String.fromCharCode(65 + i)}</span>
                  <span class="opt-t">{o}</span>
                </button>
              </li>
            ))
          }
        </ul>

        <p class="verdict" data-verdict role="status" aria-live="polite"></p>
        <div class="exp" data-exp hidden></div>

        <div class="qfoot">
          <button class="next" type="button" data-next hidden>
            Next subject <span aria-hidden="true">→</span>
          </button>
          <a class="qfoot-cta" href={APP_URL}>
            Start studying <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ samples }}>
    window.__RS_SAMPLES = samples;
  </script>

  <!-- ============================================== LIGHT: AI GENERATE -->
  <section class="light ai-band" id="ai">
    <div class="wrap">
      <div class="ai-compact">
        <span class="pill">Why AI is here</span>
        <h2 class="section-h">
          Most question banks are written for everyone.
        </h2>
        <p>
          They aim at the mass audience and leave out the specific details your
          lectures actually go into — the slides, the handouts, the bits only
          your year got taught. Upload or paste that material into Resurface and
          AI writes custom practice questions from it, so those details don't get
          dropped.
        </p>
      </div>

      <div class="ai-compare" aria-label="Generic banks versus Resurface AI">
        <figure class="compare">
          <figcaption>Most question banks</figcaption>
          <div class="compare-art miss" aria-hidden="true">
            <div class="mini-q">
              <span class="mini-tag vague">Vague</span>
              <p class="mini-stem">How many cranial nerves?</p>
              <span class="mini-ans muted">12</span>
            </div>
          </div>
          <p>Stays broad — skips lecture-specific detail.</p>
        </figure>

        <figure class="compare">
          <figcaption>Resurface AI</figcaption>
          <div class="compare-art keep" aria-hidden="true">
            <div class="mini-q">
              <span class="mini-tag specific">From your slides</span>
              <p class="mini-stem">Which nerve exits the jugular foramen?</p>
              <span class="mini-ans right">CN X</span>
            </div>
          </div>
          <p>Asks about the specific bits you were taught.</p>
        </figure>
      </div>
    </div>
  </section>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ============================================= BLUE: WHY IT WORKS -->
  <section class="why">
    <div class="wrap why-inner">
      <span class="pill on-blue">Why it works</span>
      <h2>You forget most of a lecture within a week.</h2>
      <p>
        Practising with questions beats rereading notes on its own. Resurface
        keeps track of what you're finding hard, so the time you spend studying
        goes toward the topics that still need work — not only the ones that
        already feel familiar.
      </p>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ============================================ LIGHT: HOW IT WORKS -->
  <section class="light how" id="how">
    <div class="wrap">
      <div class="head">
        <span class="pill">Simple process</span>
        <h2 class="section-h">How it works</h2>
      </div>

      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="num">{s.n}</span>
              <div class="art">
                {s.art === "answer" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="6" y="18" width="52" height="38" rx="7" fill="#c9d7ff" />
                    <rect x="17" y="12" width="52" height="38" rx="7" fill="#a7bfff" />
                    <rect x="28" y="16" width="56" height="44" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <rect x="37" y="27" width="30" height="4.5" rx="2.25" fill="#3562f5" />
                    <rect x="37" y="37" width="38" height="4.5" rx="2.25" fill="#dbe4ff" />
                    <rect x="37" y="47" width="22" height="4.5" rx="2.25" fill="#dbe4ff" />
                  </svg>
                )}
                {s.art === "generate" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="8" y="14" width="34" height="44" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <rect x="14" y="22" width="22" height="3.5" rx="1.75" fill="#dbe4ff" />
                    <rect x="14" y="30" width="18" height="3.5" rx="1.75" fill="#dbe4ff" />
                    <rect x="14" y="38" width="20" height="3.5" rx="1.75" fill="#dbe4ff" />
                    <path d="M46 36h8M50 32l8 4-8 4" fill="none" stroke="#3562f5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="54" y="14" width="34" height="44" rx="8" fill="#3562f5" />
                    <rect x="60" y="24" width="22" height="3.5" rx="1.75" fill="#a1c0ff" />
                    <rect x="60" y="34" width="16" height="8" rx="4" fill="#fff" opacity=".9" />
                    <rect x="60" y="46" width="16" height="8" rx="4" fill="#fff" opacity=".55" />
                  </svg>
                )}
                {s.art === "track" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="5" y="14" width="40" height="45" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <rect x="51" y="14" width="40" height="45" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <circle cx="25" cy="30" r="9" fill="#e2ebff" />
                    <path d="M21 30l3 3 6-6" fill="none" stroke="#3562f5" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="71" cy="30" r="9" fill="#ffe1e3" />
                    <path d="M68 27l6 6M74 27l-6 6" stroke="#e5484d" stroke-width="2.4" stroke-linecap="round" />
                    <rect x="15" y="46" width="20" height="4" rx="2" fill="#dbe4ff" />
                    <rect x="61" y="46" width="20" height="4" rx="2" fill="#dbe4ff" />
                  </svg>
                )}
              </div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ------------------------------------------------------------ CLOSER -->
  <section class="closer">
    <div class="wrap closer-inner">
      <h2>Stop rereading. Start practising.</h2>
      <p>Built for Year 1 MBChB. Free while it's in testing.</p>
      <a class="btn-white big" href={APP_URL}>Start studying <span>→</span></a>
      <p class="fine">Free while it's in testing. No account, no payment.</p>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ------------------------------------------------------------- FOOT -->
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/logo-lockup.png" alt="Resurface" width="560" height="131" />
        <p>
          A question bank for UK medical students, with AI that can write
          extra questions from your own study material.
        </p>
      </div>

      <nav class="foot-col" aria-label="Product">
        <h4>Product</h4>
        <a href="#subjects">Try a question</a>
        <a href="#ai">AI questions</a>
        <a href="#how">How it works</a>
        <a href={APP_URL}>Start studying</a>
      </nav>

      <div class="foot-col">
        <h4>Status</h4>
        <span>Free while in testing</span>
        <span>No account needed</span>
        <span>497 questions, 9 subjects</span>
      </div>
    </div>

    <div class="wrap foot-base">
      <span>© Resurface {new Date().getFullYear()}</span>
      <span>Made for Year 1 MBChB</span>
    </div>
  </footer>
</Base>

<style>
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ================================================================ FIELD */
  .field {
    position: relative;
    background: var(--blue);
    isolation: isolate;
    padding-bottom: 8px;
  }
  .field > *:not(.blobs) {
    position: relative;
    z-index: 1;
  }

  .blobs {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .blob {
    position: absolute;
    display: block;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 58% 42% 47% 53% / 45% 51% 49% 55%;
  }
  .b1 {
    width: 640px;
    height: 560px;
    top: 40px;
    right: -120px;
  }
  .b2 {
    width: 520px;
    height: 480px;
    top: 320px;
    right: 260px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%;
  }
  .b3 {
    width: 420px;
    height: 400px;
    top: 620px;
    right: -60px;
    background: rgba(255, 255, 255, 0.045);
  }

  /* ------------------------------------------------------------------ NAV */
  /* No background on the wrapper. It used to be painted blue, which meant
     a blue strip travelled down the page with the nav and sat on top of
     the white sections. The pill floats on whatever is behind it. */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 18px 24px 0;
    pointer-events: none; /* the 18px gutter shouldn't eat clicks */
  }
  .nav {
    pointer-events: auto;
    max-width: var(--wrap);
    margin: 0 auto;
    background: var(--white);
    /* A white pill on the blue field separates itself. Over .light
       (#F3F6FE) it is white-on-almost-white, so it carries its own edge:
       a hairline plus a tight contact shadow under the big soft one. */
    border: 1px solid rgba(15, 27, 61, 0.08);
    border-radius: var(--radius-pill);
    box-shadow:
      0 1px 2px rgba(15, 27, 61, 0.06),
      0 10px 30px rgba(20, 44, 130, 0.16);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 9px 9px 9px 24px;
  }
  .brand {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .brand img {
    width: 148px;
    height: auto;
  }
  .nav-links {
    display: flex;
    gap: 30px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .nav-links a:hover {
    color: var(--blue);
  }
  .nav-cta {
    background: var(--blue);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .nav-cta:hover {
    background: var(--blue-deep);
    transform: translateY(-1px);
  }

  /* ----------------------------------------------------------------- HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    align-items: center;
    gap: 40px;
    padding-top: clamp(80px, 12vh, 140px);
    padding-bottom: clamp(32px, 5vh, 60px);
  }
  .hero-copy {
    max-width: 560px;
  }

  h1 {
    color: #fff;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -2.2px;
  }
  .hl {
    color: var(--peri);
  }

  /* The zero-width space is load-bearing: the word empties to "" between
     subjects, and an empty inline box drops the line height to the caret's,
     which walked everything below it up and down on every cycle. */
  .typed {
    display: inline-block;
  }
  .typed::before {
    content: "\200B";
  }
  .caret {
    display: inline-block;
    width: 0.055em;
    height: 0.72em;
    background: var(--peri);
    margin-left: 0.07em;
    vertical-align: -0.02em;
    animation: caret-blink 1.05s steps(1, end) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .sub {
    margin-top: 24px;
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--on-blue-soft);
    max-width: 470px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .btn-white,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 16px 32px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 600;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .btn-white {
    background: #fff;
    color: var(--blue);
    box-shadow: 0 12px 30px rgba(20, 44, 130, 0.22);
  }
  .btn-white span {
    transition: transform 0.18s ease;
  }
  .btn-white:hover {
    transform: translateY(-2px);
  }
  .btn-white:hover span {
    transform: translateX(4px);
  }
  .btn-white.big {
    padding: 18px 38px;
    font-size: 18px;
  }
  .btn-ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    font-size: 14px;
    color: var(--on-blue-soft);
  }
  .note svg {
    flex: none;
  }

  /* ---------------------------------------------------------------- STAGE */
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .books {
    width: clamp(180px, 20vw, 268px);
    height: auto;
    filter: drop-shadow(0 26px 40px rgba(15, 30, 90, 0.28));
  }

  /* Frosted and deliberately rimless — measured off the comp, where the
     rim's luminance sits inside the interior's own range. */
  .chip {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--glass);
    /* Unprefixed only: hand-writing the -webkit- alias made Lightning CSS
       emit just the prefixed one, which Chromium drops. */
    backdrop-filter: blur(16px) saturate(140%);
    border-radius: 18px;
    padding: 16px 20px;
    color: #fff;
    min-width: 150px;
  }
  .chip-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }
  .chip-value {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.6px;
    line-height: 1.15;
  }
  .chip-value em {
    font-style: normal;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }
  .chip-value.big {
    font-size: 32px;
  }
  .chip-streak {
    top: 4%;
    right: -6%;
  }
  .chip-acc {
    bottom: 11%;
    right: -2%;
  }
  /* Aspect matches the 124x32 viewBox so the bars aren't letterboxed. */
  .bars {
    width: 112px;
