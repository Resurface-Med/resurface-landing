---
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";

const APP_URL = import.meta.env.PUBLIC_APP_URL || "#";

const pillars = [
  {
    icon: "recall",
    title: "Active recall",
    body: "Answer before you look. Five options, an explanation for the right one and for every wrong one.",
  },
  {
    icon: "spaced",
    title: "Spaced repetition",
    body: "An SM-2 schedule with Anki-style learning steps decides when each question comes back.",
  },
  {
    icon: "retention",
    title: "Long-term retention",
    body: "Study smarter, not longer. Remember it in June, not just the week you covered it.",
  },
];

const steps = [
  {
    n: "1",
    art: "answer",
    title: "Answer",
    body: "Work through multiple-choice questions under exam conditions. Five options, one right.",
  },
  {
    n: "2",
    art: "track",
    title: "We track",
    body: "The schedule records what you got wrong — and what you only just scraped.",
  },
  {
    n: "3",
    art: "return",
    title: "It comes back",
    body: "The question returns at the point you'd otherwise have forgotten it.",
  },
];

const subjects = [
  "Anatomy",
  "Biochemistry",
  "Embryology",
  "Genetics",
  "Histology",
  "Immunology",
  "Pathology",
  "Pharmacology",
  "Physiology",
];

const modes = [
  { n: "01", t: "Practice", d: "Pick a subject and work through it. No clock, no pressure." },
  { n: "02", t: "Timed", d: "Race the clock the way the real paper makes you." },
  { n: "03", t: "Review queue", d: "Only what's due today, decided by the schedule." },
];

/* Countable facts only — see the note in the closer section. */
const stats = [
  { v: "497", l: "Questions in the bank" },
  { v: "9", l: "Subjects covered" },
  { v: "3", l: "Ways to study" },
];

const marquee = "Resurface it. Just before it sinks. ";
const wiggle =
  "M2,14 C18,2 34,26 50,14 C66,2 82,26 98,14 C114,2 130,26 146,14 C162,2 178,26 198,12";
---

<Base
  title="Resurface — spaced repetition for medical school"
  description="A spaced-repetition study app for medical students. Questions resurface right before you forget them."
>
  <!-- -------------------------------------------------------------- NAV -->
  <!-- Outside .field deliberately. A sticky element only sticks within its
       own container, and .field ends at the first wave. -->
  <header class="nav-wrap">
    <nav class="nav">
      <a class="brand" href="/">
        <img
          src="/logo-lockup.png"
          alt="Resurface"
          width="560"
          height="131"
          fetchpriority="high"
        />
      </a>

      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#subjects">Subjects</a>
        <a href="#modes">Question modes</a>
      </div>

      <a class="nav-cta" href={APP_URL}>Start studying</a>
    </nav>
  </header>

  <!-- ================================================== THE BLUE FIELD -->
  <div class="field">
    <div class="blobs" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
    </div>

    <!-- ----------------------------------------------------------- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <!-- The subject is server-rendered as a real value, so the h1 says
             something meaningful with JS off and to a crawler. The animated
             span is hidden from assistive tech — a node whose text mutates
             every 85ms is unusable — and .vh carries the meaning. -->
        <h1>
          I want to study<br />
          <span class="typed">
            <span class="typed-out hl" aria-hidden="true">Pathology</span
            ><span class="caret" aria-hidden="true"></span>
            <span class="vh"
              >pathology, physiology, anatomy, and six more subjects.</span
            >
          </span>
        </h1>

        <p class="sub">
          A spaced-repetition question bank for medical students. It tracks
          what you're about to forget and puts it back in front of you at the
          moment it counts.
        </p>

        <div class="cta">
          <a class="btn-white" href={APP_URL}>Start studying <span>→</span></a>
          <a class="btn-ghost" href="#how">How it works</a>
        </div>

        <p class="note">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="9" fill="rgba(255,255,255,.22)"></circle>
            <path
              d="M6 10.2l2.6 2.6L14 7.4"
              fill="none"
              stroke="#fff"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Free while it's in testing. No account needed.
        </p>
      </div>

      <div class="stage">
        <img
          class="books"
          src="/books.webp"
          alt="Two stacked textbooks"
          width="580"
          height="839"
        />

        <div class="chip chip-streak">
          <span class="chip-label">Streak</span>
          <span class="chip-value">12 <em>days</em></span>
          <svg class="bars" viewBox="0 0 124 32" aria-hidden="true">
            <g fill="#fff">
              <rect x="0" y="22" width="14" height="10" rx="4" opacity=".55"
              ></rect>
              <rect x="22" y="18" width="14" height="14" rx="4" opacity=".64"
              ></rect>
              <rect x="44" y="14" width="14" height="18" rx="4" opacity=".73"
              ></rect>
              <rect x="66" y="9" width="14" height="23" rx="4" opacity=".82"
              ></rect>
              <rect x="88" y="5" width="14" height="27" rx="4" opacity=".91"
              ></rect>
              <rect x="110" y="0" width="14" height="32" rx="4"></rect>
            </g>
          </svg>
        </div>

        <div class="chip chip-acc">
          <span class="chip-value big">84%</span>
          <span class="chip-label">Accuracy</span>
          <span class="bar"><i style="width:84%"></i></span>
        </div>
      </div>
    </section>

    <!-- ---------------------------------------------------------- PROOF -->
    <div class="wrap">
      <div class="proof">
        <svg class="proof-icon" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="9" fill="rgba(255,255,255,.22)"></circle>
          <path
            d="M6 10.2l2.6 2.6L14 7.4"
            fill="none"
            stroke="#fff"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p>
          Every question written and checked by hand for Year 1 MBChB — not
          scraped, not auto-padded.
        </p>
      </div>
    </div>

    <!-- --------------------------------------------------------- RIBBON -->
    <!-- A white ribbon across the blue, text riding its centreline. The
         path overshoots the viewBox on both sides so the band runs off
         screen rather than terminating at the edge. -->
    <div class="ribbon" aria-hidden="true">
      <svg viewBox="0 0 1440 250" preserveAspectRatio="none">
        <path
          class="ribbon-fill"
          d="M-160,96 C160,8 520,8 800,96 C1080,184 1300,184 1600,96 L1600,188 C1300,276 1080,276 800,188 C520,100 160,100 -160,188 Z"
        ></path>
        <path
          id="ribbonline"
          fill="none"
          d="M-160,158 C160,70 520,70 800,158 C1080,246 1300,246 1600,158"
        ></path>
        <text class="ribbon-text">
          <textPath href="#ribbonline" startOffset="0%">
            {marquee.repeat(6)}
            <animate
              attributeName="startOffset"
              from="0%"
              to="-25%"
              dur="24s"
              repeatCount="indefinite"
            />
          </textPath>
        </text>
      </svg>
    </div>
  </div>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ================================================== LIGHT: PILLARS -->
  <section class="light pillars-band">
    <div class="wrap">
      <div class="sheet">
        {
          pillars.map((p) => (
            <article class="pillar">
              <span class="tile">
                {p.icon === "recall" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="6" width="12" height="14" rx="3" />
                    <path d="M9 4h9a3 3 0 0 1 3 3v10" />
                  </svg>
                )}
                {p.icon === "spaced" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9v6M10 6v12M16 8v8M21 10v4" />
                  </svg>
                )}
                {p.icon === "retention" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9z" />
                  </svg>
                )}
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ LIGHT: HOW IT WORKS -->
  <section class="light how" id="how">
    <div class="wrap">
      <div class="head">
        <span class="pill">Simple process</span>
        <h2 class="section-h">How it works</h2>
      </div>

      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="num">{s.n}</span>
              <div class="art">
                {s.art === "answer" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="6" y="18" width="52" height="38" rx="7" fill="#c9d7ff" />
                    <rect x="17" y="12" width="52" height="38" rx="7" fill="#a7bfff" />
                    <rect x="28" y="16" width="56" height="44" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <rect x="37" y="27" width="30" height="4.5" rx="2.25" fill="#3562f5" />
                    <rect x="37" y="37" width="38" height="4.5" rx="2.25" fill="#dbe4ff" />
                    <rect x="37" y="47" width="22" height="4.5" rx="2.25" fill="#dbe4ff" />
                  </svg>
                )}
                {s.art === "track" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="5" y="14" width="40" height="45" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <rect x="51" y="14" width="40" height="45" rx="8" fill="#fff" stroke="#d6e0f5" />
                    <circle cx="25" cy="30" r="9" fill="#e2ebff" />
                    <path d="M21 30l3 3 6-6" fill="none" stroke="#3562f5" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="71" cy="30" r="9" fill="#ffe1e3" />
                    <path d="M68 27l6 6M74 27l-6 6" stroke="#e5484d" stroke-width="2.4" stroke-linecap="round" />
                    <rect x="15" y="46" width="20" height="4" rx="2" fill="#dbe4ff" />
                    <rect x="61" y="46" width="20" height="4" rx="2" fill="#dbe4ff" />
                  </svg>
                )}
                {s.art === "return" && (
                  <svg viewBox="0 0 96 72" aria-hidden="true">
                    <rect x="20" y="12" width="56" height="50" rx="9" fill="#fff" stroke="#d6e0f5" />
                    <path d="M20 21a9 9 0 0 1 9-9h38a9 9 0 0 1 9 9v5H20z" fill="#3562f5" />
                    <rect x="31" y="6" width="5" height="12" rx="2.5" fill="#1e42c9" />
                    <rect x="60" y="6" width="5" height="12" rx="2.5" fill="#1e42c9" />
                    <g fill="#dbe4ff">
                      <rect x="28" y="33" width="8" height="7" rx="2" />
                      <rect x="42" y="33" width="8" height="7" rx="2" />
                      <rect x="56" y="33" width="8" height="7" rx="2" />
                      <rect x="28" y="45" width="8" height="7" rx="2" />
                      <rect x="56" y="45" width="8" height="7" rx="2" />
                    </g>
                    <rect x="42" y="45" width="8" height="7" rx="2" fill="#3562f5" />
                  </svg>
                )}
              </div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ============================================= BLUE: WHY IT WORKS -->
  <section class="why">
    <div class="wrap why-inner">
      <span class="pill on-blue">Why it works</span>
      <h2>You forget most of a lecture within a week.</h2>
      <p>
        Revisiting material at widening intervals beats rereading it — it is
        one of the most reliably reproduced findings in memory research.
        Resurface runs that schedule for you, so the decision about what to
        study today isn't yours to make.
      </p>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- =========================================== LIGHT: SUBJECTS/MODES -->
  <section class="light" id="subjects">
    <div class="wrap subjects">
      <div class="subjects-head">
        <h2 class="section-h">Nine subjects, ready to go.</h2>
        <p>
          Year 1 MBChB, written and checked by hand. Add your own on top
          whenever you like.
        </p>
      </div>
      <ul class="chips">
        {subjects.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="wrap modes" id="modes">
      {
        modes.map((m) => (
          <div class="mode-card">
            <span class="mode-n">{m.n}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </div>
        ))
      }
    </div>

    <!-- ---------------------------------------------------------- STATS -->
    <div class="wrap">
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="stat-v">{s.v}</span>
              <span class="stat-l">{s.l}</span>
              <svg class="wiggle" viewBox="0 0 200 24" aria-hidden="true">
                <path
                  d={wiggle}
                  fill="none"
                  stroke="var(--blue)"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="var(--panel)" to="var(--blue)" flip />

  <!-- ------------------------------------------------------------ CLOSER -->
  <section class="closer">
    <div class="wrap closer-inner">
      <h2>Stop rereading. Start remembering.</h2>
      <p>Built for Year 1 MBChB. Your progress stays on your device.</p>
      <a class="btn-white big" href={APP_URL}>Start studying <span>→</span></a>
      <p class="fine">Free while it's in testing. No account, no payment.</p>
    </div>
  </section>

  <Wave from="var(--blue)" to="var(--panel)" />

  <!-- ------------------------------------------------------------- FOOT -->
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/logo-lockup.png" alt="Resurface" width="560" height="131" />
        <p>
          A spaced-repetition question bank for Year 1 MBChB. Built by a
          medical student, for medical students.
        </p>
      </div>

      <nav class="foot-col" aria-label="Product">
        <h4>Product</h4>
        <a href="#how">How it works</a>
        <a href="#subjects">Subjects</a>
        <a href="#modes">Question modes</a>
        <a href={APP_URL}>Start studying</a>
      </nav>

      <div class="foot-col">
        <h4>Status</h4>
        <span>Free while in testing</span>
        <span>No account needed</span>
        <span>497 questions, 9 subjects</span>
      </div>
    </div>

    <div class="wrap foot-base">
      <span>© Resurface {new Date().getFullYear()}</span>
      <span>Made for Year 1 MBChB</span>
    </div>
  </footer>
</Base>

<style>
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ================================================================ FIELD */
  .field {
    position: relative;
    background: var(--blue);
    isolation: isolate;
    padding-bottom: 8px;
  }
  .field > *:not(.blobs) {
    position: relative;
    z-index: 1;
  }

  .blobs {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .blob {
    position: absolute;
    display: block;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 58% 42% 47% 53% / 45% 51% 49% 55%;
  }
  .b1 {
    width: 640px;
    height: 560px;
    top: 40px;
    right: -120px;
  }
  .b2 {
    width: 520px;
    height: 480px;
    top: 320px;
    right: 260px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%;
  }
  .b3 {
    width: 420px;
    height: 400px;
    top: 620px;
    right: -60px;
    background: rgba(255, 255, 255, 0.045);
  }

  /* ------------------------------------------------------------------ NAV */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 18px 24px 0;
    background: var(--blue);
  }
  .nav {
    max-width: var(--wrap);
    margin: 0 auto;
    background: var(--white);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 9px 9px 9px 24px;
  }
  .brand {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .brand img {
    width: 148px;
    height: auto;
  }
  .nav-links {
    display: flex;
    gap: 30px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .nav-links a:hover {
    color: var(--blue);
  }
  .nav-cta {
    background: var(--blue);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .nav-cta:hover {
    background: var(--blue-deep);
    transform: translateY(-1px);
  }

  /* ----------------------------------------------------------------- HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    align-items: center;
    gap: 40px;
    padding-top: clamp(48px, 7vh, 88px);
    padding-bottom: clamp(32px, 5vh, 60px);
  }
  .hero-copy {
    max-width: 560px;
  }

  h1 {
    color: #fff;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -2.2px;
  }
  .hl {
    color: var(--peri);
  }

  /* The zero-width space is load-bearing: the word empties to "" between
     subjects, and an empty inline box drops the line height to the caret's,
     which walked everything below it up and down on every cycle. */
  .typed {
    display: inline-block;
  }
  .typed::before {
    content: "\200B";
  }
  .caret {
    display: inline-block;
    width: 0.055em;
    height: 0.72em;
    background: var(--peri);
    margin-left: 0.07em;
    vertical-align: -0.02em;
    animation: caret-blink 1.05s steps(1, end) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .sub {
    margin-top: 24px;
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--on-blue-soft);
    max-width: 470px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .btn-white,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 16px 32px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 600;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .btn-white {
    background: #fff;
    color: var(--blue);
    box-shadow: 0 12px 30px rgba(20, 44, 130, 0.22);
  }
  .btn-white span {
    transition: transform 0.18s ease;
  }
  .btn-white:hover {
    transform: translateY(-2px);
  }
  .btn-white:hover span {
    transform: translateX(4px);
  }
  .btn-white.big {
    padding: 18px 38px;
    font-size: 18px;
  }
  .btn-ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    font-size: 14px;
    color: var(--on-blue-soft);
  }
  .note svg {
    flex: none;
  }

  /* ---------------------------------------------------------------- STAGE */
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .books {
    width: clamp(180px, 20vw, 268px);
    height: auto;
    filter: drop-shadow(0 26px 40px rgba(15, 30, 90, 0.28));
  }

  /* Frosted and deliberately rimless — measured off the comp, where the
     rim's luminance sits inside the interior's own range. */
  .chip {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--glass);
    /* Unprefixed only: hand-writing the -webkit- alias made Lightning CSS
       emit just the prefixed one, which Chromium drops. */
    backdrop-filter: blur(16px) saturate(140%);
    border-radius: 18px;
    padding: 16px 20px;
    color: #fff;
    min-width: 150px;
  }
  .chip-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }
  .chip-value {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.6px;
    line-height: 1.15;
  }
  .chip-value em {
    font-style: normal;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }
  .chip-value.big {
    font-size: 32px;
  }
  .chip-streak {
    top: 4%;
    right: -6%;
  }
  .chip-acc {
    bottom: 11%;
    right: -2%;
  }
  /* Aspect matches the 124x32 viewBox so the bars aren't letterboxed. */
  .bars {
    width: 112px;
    height: 29px;
    margin-top: 6px;
  }
  .bar {
    display: block;
    margin-top: 10px;
    height: 5px;
    width: 100%;
    background: rgba(255, 255, 255, 0.28);
    border-radius: 99px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: #fff;
    border-radius: 99px;
  }

  /* ---------------------------------------------------------------- PROOF */
  .proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: fit-content;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    padding: 12px 26px;
