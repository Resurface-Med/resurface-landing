  /* -------------------------------------------------------------- CLOSER */
  .closer {
    background: var(--blue);
    color: #fff;
    padding: clamp(64px, 10vh, 104px) 0;
  }
  .closer-inner {
    text-align: center;
  }
  .closer h2 {
    font-size: clamp(30px, 4.1vw, 48px);
    font-weight: 600;
    letter-spacing: -1.2px;
  }
  .closer p {
    margin: 14px auto 32px;
    color: var(--on-blue-soft);
    font-size: 17px;
  }

  /* ---------------------------------------------------------------- FOOT */
  .foot {
    background: var(--blue);
    padding: 8px 0 30px;
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.62);
  }

  /* ================================================================ SMALL */

  /* The stat chips hang off the stage by a negative percentage, which is
     fine at full width but pushes past the viewport once the hero column
     narrows — .chip-streak was the whole of a 7px horizontal scroll at
     1180px. Tuck them in before that happens. */
  @media (max-width: 1240px) {
    .chip-streak {
      right: 0;
    }
    .chip-acc {
      right: 2%;
    }
  }

  /* The stage collapses first: below this the books and the stat chips
     have less room than the chips' own min-width, so they'd overlap the
     copy column exactly the way the old hero's artwork did. */
  @media (max-width: 1040px) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .hero-copy {
      max-width: none;
    }
    .stage {
      display: none;
    }
    .blob {
      opacity: 0.6;
    }
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .nav {
      padding-left: 18px;
    }
    h1 {
      letter-spacing: -1.4px;
    }
    .proof {
      width: auto;
    }
  }

  @media (max-width: 560px) {
    h1 {
      letter-spacing: -1.2px;
    }
    .brand img {
      width: 124px;
    }
    .nav-cta {
      font-size: 14px;
      padding: 11px 18px;
    }
    .nav {
      gap: 12px;
      padding-left: 16px;
    }
    .sheet {
      padding: 28px 8px;
      margin-bottom: -70px;
    }
    .rest {
      padding-top: 120px;
    }
    .proof {
      flex-direction: column;
      text-align: center;
      padding: 18px 22px;
      border-radius: var(--radius-lg);
    }
  }

  /* Must come after the 560px block — same specificity, so source order
     decides. The clamp floor of 42px fits "Biochemistry", the longest
     subject, down to about 360px and no further; below that it wrapped to
     a second line and jumped the headline 45px mid-animation. */
  @media (max-width: 360px) {
    h1 {
      font-size: 34px;
      letter-spacing: -0.9px;
    }
  }
</style>

<script>
  // Types the subject in the hero headline. The markup already ships a
  // real subject, so this only ever replaces one valid word with another
  // — with JS off, or before hydration, the headline still reads.
  const out = document.querySelector<HTMLElement>(".typed-out");

  if (out && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // The nine that actually exist in the question bank.
    const subjects = [
      "Pathology",
      "Physiology",
      "Anatomy",
      "Pharmacology",
      "Immunology",
      "Biochemistry",
      "Histology",
      "Embryology",
      "Genetics",
    ];

    // Start on whatever the server rendered, mid-word, and delete from
    // there — otherwise the first frame would blank the headline.
    let word = Math.max(0, subjects.indexOf(out.textContent?.trim() ?? ""));
    let chars = subjects[word].length;
    let deleting = true;

    const HOLD = 1700; // full word sits still
    const GAP = 240; // beat between words
    const TYPE = 85;
    const ERASE = 40;

    const tick = () => {
      const target = subjects[word];
      chars += deleting ? -1 : 1;
      out.textContent = target.slice(0, chars);

      let next = deleting ? ERASE : TYPE;
      if (!deleting && chars === target.length) {
        deleting = true;
        next = HOLD;
      } else if (deleting && chars === 0) {
        deleting = false;
        word = (word + 1) % subjects.length;
        next = GAP;
      }
      setTimeout(tick, next);
    };

    setTimeout(tick, HOLD);
  }
</script>
