<script>
  // Types the subject in the hero headline. The markup already ships a real
  // subject, so this only ever replaces one valid word with another.
  const out = document.querySelector<HTMLElement>(".typed-out");

  if (out && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const subjects = [
      "Pathology",
      "Physiology",
      "Anatomy",
      "Pharmacology",
      "Immunology",
      "Biochemistry",
      "Histology",
      "Embryology",
      "Genetics",
    ];

    // Start from whatever the server rendered and delete from there,
    // otherwise the first frame would blank the headline.
    let word = Math.max(0, subjects.indexOf(out.textContent?.trim() ?? ""));
    let chars = subjects[word].length;
    let deleting = true;

    const HOLD = 1700;
    const GAP = 240;
    const TYPE = 85;
    const ERASE = 40;

    const tick = () => {
      const target = subjects[word];
      chars += deleting ? -1 : 1;
      out.textContent = target.slice(0, chars);

      let next = deleting ? ERASE : TYPE;
      if (!deleting && chars === target.length) {
        deleting = true;
        next = HOLD;
      } else if (deleting && chars === 0) {
        deleting = false;
        word = (word + 1) % subjects.length;
        next = GAP;
      }
      setTimeout(tick, next);
    };

    setTimeout(tick, HOLD);
  }
</script>

<script>
  // The subject demo. Everything it renders already exists in the markup
  // for subject 0, so with JS off the card is a complete, readable
  // question — this only swaps contents and wires up answering.
  type Sample = {
    subject: string;
    topic: string;
    q: string;
    opts: string[];
    ans: number;
    exp: string;
    optExp: string[];
  };

  const samples: Sample[] = (window as any).__RS_SAMPLES ?? [];
  const card = document.querySelector<HTMLElement>("#qcard");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".subj")];

  if (card && tabs.length && samples.length) {
    const calm = matchMedia("(prefers-reduced-motion: reduce)");
    const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;

    const stem = $<HTMLElement>("[data-stem]");
    const topic = $<HTMLElement>("[data-topic]");
    const optList = $<HTMLElement>("[data-opts]");
    // Reused, never regenerated. Astro scopes its CSS with a data-astro-cid
    // attribute, so anything built here with innerHTML matches no rule and
    // renders unstyled. Mutating the server-rendered buttons keeps the
    // scope attribute — and the frontmatter guarantees five of them.
    const optButtons = [...optList.querySelectorAll<HTMLButtonElement>(".opt")];
    const verdict = $<HTMLElement>("[data-verdict]");
    const exp = $<HTMLElement>("[data-exp]");
    const next = $<HTMLButtonElement>("[data-next]");

    let current = 0;
    let answered = false;

    const letter = (i: number) => String.fromCharCode(65 + i);

    const reveal = (picked: number) => {
      if (answered) return;
      answered = true;
      const s = samples[current];

      optButtons.forEach((b, i) => {
        b.disabled = true;
        if (i === s.ans) b.classList.add("right");
        else if (i === picked) b.classList.add("wrong");
      });

      const right = picked === s.ans;
      verdict.textContent = right
        ? "Correct."
        : `Not quite — it's ${letter(s.ans)}.`;

      // The per-option explanation is the point: you get told why *your*
      // answer was wrong, not just what the right one was.
      const why =
        !right && s.optExp[picked]
          ? `<b>${letter(picked)}:</b> ${s.optExp[picked]}<br />`
          : "";
      exp.innerHTML = `${why}<b>${letter(s.ans)}:</b> ${s.exp}`;
      exp.hidden = false;
      next.hidden = false;

      if (!right && !calm.matches) {
        card.classList.add("shake");
        setTimeout(() => card.classList.remove("shake"), 400);
      }
    };

    const render = (i: number, animate = true) => {
      current = i;
      answered = false;
      const s = samples[i];

      topic.textContent = s.topic;
      stem.textContent = s.q;
      optButtons.forEach((btn, k) => {
        btn.disabled = false;
        btn.classList.remove("right", "wrong");
        // textContent, not innerHTML — a stem or option containing markup
        // characters can then never inject into the card.
        btn.querySelector<HTMLElement>(".opt-k")!.textContent = letter(k);
        btn.querySelector<HTMLElement>(".opt-t")!.textContent = s.opts[k];
      });

      verdict.textContent = "";
      exp.hidden = true;
      exp.textContent = "";
      next.hidden = true;

      if (animate && !calm.matches) {
        card.classList.remove("swap");
        void card.offsetWidth; // restart the animation
        card.classList.add("swap");
      }
    };

    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.classList.toggle("on", on);
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      });
      card.setAttribute("aria-labelledby", `tab-${i}`);
      render(i);
      if (focus) tabs[i].focus();
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));

    // Roving tabindex: a tablist should move with the arrow keys.
    document
      .querySelector(".chips")!
      .addEventListener("keydown", (e: Event) => {
        const k = (e as KeyboardEvent).key;
        const at = tabs.findIndex((t) => t === document.activeElement);
        if (at < 0) return;
        let to = at;
        if (k === "ArrowRight" || k === "ArrowDown") to = (at + 1) % tabs.length;
        else if (k === "ArrowLeft" || k === "ArrowUp")
          to = (at - 1 + tabs.length) % tabs.length;
        else if (k === "Home") to = 0;
        else if (k === "End") to = tabs.length - 1;
        else return;
        e.preventDefault();
        select(to, true);
      });

    optList.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".opt");
      if (b) reveal(Number(b.dataset.o));
    });

    next.addEventListener("click", () => select((current + 1) % samples.length));
  }
</script>
